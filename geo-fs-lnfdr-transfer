/* =========================================================
   导出
   ========================================================= */
function exportFile(){
  if (!appState.records){ toast('请先载入数据', 'err'); return; }

  var rawSamples = sampleWindow(appState.records, appState.windowSize, appState.interval);
  if (rawSamples.length < 2){ toast('输出点数不足', 'err'); return; }

  if (appState.mode === 'g2l'){
    exportLNFDRFile(rawSamples);
  } else {
    exportGeoFSFile(rawSamples);
  }
}

function exportLNFDRFile(samples){
  var meta = {
    aircraftType: $('fAircraft').value.trim() || 'Unknown Aircraft',
    tailNumber:   $('fTail').value.trim() || '',
    flightNumber: $('fFlight').value.trim() || '',
    date:         $('fDate').value || new Date().toISOString().slice(0, 10),
    recorderType: 'GeoFS Flight Data',
    operator:     $('fOperator').value.trim() || ''
  };

  var lnfdr = buildLNFDR(samples, meta);
  var content = JSON.stringify(lnfdr, null, 2);

  var parts = ['GeoFS'];
  if (meta.flightNumber) parts.push(meta.flightNumber);
  else if (meta.tailNumber) parts.push(meta.tailNumber);
  else if (meta.aircraftType) parts.push(meta.aircraftType.replace(/\s+/g, '_').replace(/#/g, ''));

  var d = new Date();
  var p = function(n){ return String(n).padStart(2, '0'); };
  parts.push(d.getFullYear() + p(d.getMonth()+1) + p(d.getDate()) + '_' + p(d.getHours()) + p(d.getMinutes()));

  var filename = parts.join('_') + '.LNFDR';
  downloadBlob(content, filename, 'application/json;charset=utf-8');
  toast('已导出 LNFDR · ' + samples.length + ' 点 → ' + filename, 'ok');
}

function exportGeoFSFile(rawSamples){
  var selVal = $('fBaseCoord').value;
  var base = getBaseCoord();

  if (!base){
    toast('请选择或填写有效的起点坐标', 'err');
    return;
  }

  // 从起点积分
  var samples = integratePosition(rawSamples, base.lat, base.lon);

  var opts = {
    aircraftId: $('fGeoAircraftId').value.trim() || '25',
    livery: (appState.sourceInfo && appState.sourceInfo.livery) || '0'
  };

  var geo = buildGeoFS(samples, opts);
  var content = JSON.stringify(geo);

  var airTxt = $('fAircraft').value.trim().replace(/\s+/g, '_').replace(/#/g, '') || 'GeoFS';
  var tag = '_' + base.name.replace(/\s+/g, '').replace(/[()]/g, '');
  var d = new Date();
  var p = function(n){ return String(n).padStart(2, '0'); };
  var stamp = d.getFullYear() + p(d.getMonth()+1) + p(d.getDate()) + '_' + p(d.getHours()) + p(d.getMinutes());

  var filename = 'GeoFS_' + airTxt + tag + '_' + stamp + '.json';
  downloadBlob(content, filename, 'application/json;charset=utf-8');

  toast('已导出 GeoFS · ' + samples.length + ' 帧 · 起点 ' + base.name, 'ok');
}

function downloadBlob(content, filename, mime){
  var blob = new Blob([content], { type: mime || 'application/octet-stream' });
  var a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = filename;
  document.body.appendChild(a);
  a.click();
  a.remove();
  setTimeout(function(){ URL.revokeObjectURL(a.href); }, 1500);
}

/* =========================================================
   UI 绑定
   ========================================================= */
function bindUI(){
  $('modeG2L').addEventListener('click', function(){
    if (appState.mode !== 'g2l') setMode('g2l');
  });
  $('modeL2G').addEventListener('click', function(){
    if (appState.mode !== 'l2g') setMode('l2g');
  });

  var input = $('fileInput');
  input.addEventListener('change', function(e){
    var f = e.target.files && e.target.files[0];
    if (f) handleFile(f);
    e.target.value = '';
  });

  var dz = $('dropzone');
  dz.addEventListener('click', function(){ input.click(); });
  dz.addEventListener('dragover', function(e){
    e.preventDefault(); dz.classList.add('drag');
  });
  dz.addEventListener('dragleave', function(){ dz.classList.remove('drag'); });
  dz.addEventListener('drop', function(e){
    e.preventDefault(); dz.classList.remove('drag');
    var f = e.dataTransfer.files && e.dataTransfer.files[0];
    if (f) handleFile(f);
  });

  var windowSlider = $('windowSlider');
  windowSlider.addEventListener('input', function(){
    appState.windowSize = parseFloat(windowSlider.value) || 1800;
    updateWindowLabel();
    updateSliderVisual(windowSlider);
    updatePreview();
  });

  var intervalSlider = $('intervalSlider');
  intervalSlider.addEventListener('input', function(){
    appState.interval = parseFloat(intervalSlider.value) || 1;
    updateIntervalLabel();
    updateSliderVisual(intervalSlider);
    updatePreview();
  });
  updateSliderVisual(intervalSlider);

  // 起点选择
  var baseSelect = $('fBaseCoord');
  baseSelect.addEventListener('change', function(){
    if (baseSelect.value === 'custom'){
      $('customCoordRow').style.display = '';
    } else {
      $('customCoordRow').style.display = 'none';
    }
    updatePreview();
  });

  $('fBaseLat').addEventListener('input', updatePreview);
  $('fBaseLon').addEventListener('input', updatePreview);

  $('btnExport').addEventListener('click', exportFile);

  $('btnReset').addEventListener('click', function(){
    if (appState.records && !confirm('确定重置？当前数据将丢失。')) return;
    clearData(false);
    $('fBaseCoord').value = 'ont';
    $('customCoordRow').style.display = 'none';
    $('fBaseLat').value = '';
    $('fBaseLon').value = '';
    toast('已重置', 'ok');
  });
}

/* =========================================================
   启动
   ========================================================= */
function boot(){
  bindUI();

  var is = $('intervalSlider');
  is.style.setProperty('--p', ((1 - 0.2)/(5 - 0.2)*100) + '%');

  renderStats(null);
  drawEmptyCanvas();

  $('fDate').value = new Date().toISOString().slice(0, 10);
  setMode('g2l', true);
}

if (document.readyState === 'loading'){
  document.addEventListener('DOMContentLoaded', boot);
} else {
  boot();
}

})();
</script>
</body>
</html>
