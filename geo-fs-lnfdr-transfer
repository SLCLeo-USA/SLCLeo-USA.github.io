function drawEmptyCanvas(){
  var cvs = $('preview');
  var ctx = cvs.getContext('2d');
  var W = cvs.width, H = cvs.height;
  ctx.clearRect(0, 0, W, H);
  ctx.fillStyle = 'rgba(90,180,255,.15)';
  ctx.font = '16px system-ui, sans-serif';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.fillText('载入数据后显示轨迹预览', W/2, H/2);
}

function drawTrackPreview(samples){
  var cvs = $('preview');
  var ctx = cvs.getContext('2d');
  var W = cvs.width, H = cvs.height;
  ctx.clearRect(0, 0, W, H);

  if (!samples || samples.length < 2){ drawEmptyCanvas(); return; }

  var valid = samples.filter(function(s){
    return isFinite(s.lat) && isFinite(s.lon);
  });
  if (valid.length < 2){ drawEmptyCanvas(); return; }

  var minLat = Infinity, maxLat = -Infinity;
  var minLon = Infinity, maxLon = -Infinity;
  for (var i = 0; i < valid.length; i++){
    var s = valid[i];
    if (s.lat < minLat) minLat = s.lat;
    if (s.lat > maxLat) maxLat = s.lat;
    if (s.lon < minLon) minLon = s.lon;
    if (s.lon > maxLon) maxLon = s.lon;
  }

  var latRange = maxLat - minLat;
  var lonRange = maxLon - minLon;
  if (latRange < 1e-6) latRange = 0.0005;
  if (lonRange < 1e-6) lonRange = 0.0005;

  var padLat = latRange * 0.08;
  var padLon = lonRange * 0.08;
  minLat -= padLat; maxLat += padLat;
  minLon -= padLon; maxLon += padLon;
  latRange = maxLat - minLat;
  lonRange = maxLon - minLon;

  var padding = 40;
  var innerW = W - padding * 2;
  var innerH = H - padding * 2;

  var aspect = lonRange / latRange;
  var canvasAspect = innerW / innerH;
  var drawW, drawH, offsetX, offsetY;
  if (aspect > canvasAspect){
    drawW = innerW; drawH = innerW / aspect;
    offsetX = padding; offsetY = padding + (innerH - drawH) / 2;
  } else {
    drawH = innerH; drawW = innerH * aspect;
    offsetX = padding + (innerW - drawW) / 2; offsetY = padding;
  }

  function project(lat, lon){
    return [
      offsetX + ((lon - minLon) / lonRange) * drawW,
      offsetY + (1 - (lat - minLat) / latRange) * drawH
    ];
  }

  ctx.strokeStyle = 'rgba(90,120,160,.1)';
  ctx.lineWidth = 1;
  for (var gx = 0; gx <= 10; gx++){
    var xx = offsetX + (gx / 10) * drawW;
    ctx.beginPath(); ctx.moveTo(xx, offsetY); ctx.lineTo(xx, offsetY + drawH); ctx.stroke();
  }
  for (var gy = 0; gy <= 10; gy++){
    var yy = offsetY + (gy / 10) * drawH;
    ctx.beginPath(); ctx.moveTo(offsetX, yy); ctx.lineTo(offsetX + drawW, yy); ctx.stroke();
  }

  ctx.strokeStyle = 'rgba(90,120,160,.3)';
  ctx.strokeRect(offsetX, offsetY, drawW, drawH);

  var altMin = Infinity, altMax = -Infinity, hasAlt = false;
  for (var k = 0; k < valid.length; k++){
    if (isFinite(valid[k].altFt)){
      hasAlt = true;
      if (valid[k].altFt < altMin) altMin = valid[k].altFt;
      if (valid[k].altFt > altMax) altMax = valid[k].altFt;
    }
  }
  var altRange = hasAlt ? Math.max(1, altMax - altMin) : 1;

  ctx.lineWidth = 3;
  ctx.lineJoin = 'round';
  ctx.lineCap = 'round';

  for (var m = 0; m < valid.length - 1; m++){
    var p0 = project(valid[m].lat, valid[m].lon);
    var p1 = project(valid[m+1].lat, valid[m+1].lon);

    if (hasAlt && isFinite(valid[m].altFt)){
      var u = (valid[m].altFt - altMin) / altRange;
      var r = Math.round(255 * (0.95 - u * 0.75));
      var g = Math.round(255 * (0.32 + u * 0.55));
      var b = Math.round(255 * (0.30 + u * 0.68));
      ctx.strokeStyle = 'rgba(' + r + ',' + g + ',' + b + ',.95)';
    } else {
      ctx.strokeStyle = 'rgba(90,180,255,.9)';
    }

    ctx.beginPath();
    ctx.moveTo(p0[0], p0[1]);
    ctx.lineTo(p1[0], p1[1]);
    ctx.stroke();
  }

  var start = project(valid[0].lat, valid[0].lon);
  var end = project(valid[valid.length-1].lat, valid[valid.length-1].lon);

  ctx.fillStyle = '#3fe08a';
  ctx.beginPath(); ctx.arc(start[0], start[1], 7, 0, Math.PI * 2); ctx.fill();
  ctx.strokeStyle = 'rgba(63,224,138,.4)'; ctx.lineWidth = 3;
  ctx.beginPath(); ctx.arc(start[0], start[1], 12, 0, Math.PI * 2); ctx.stroke();

  ctx.fillStyle = '#ff4d4d';
  ctx.beginPath(); ctx.arc(end[0], end[1], 7, 0, Math.PI * 2); ctx.fill();
  ctx.strokeStyle = 'rgba(255,77,77,.4)'; ctx.lineWidth = 3;
  ctx.beginPath(); ctx.arc(end[0], end[1], 12, 0, Math.PI * 2); ctx.stroke();

  ctx.font = 'bold 11px "SF Mono", monospace';
  ctx.textBaseline = 'middle';
  ctx.fillStyle = '#3fe08a';
  ctx.textAlign = 'left';
  ctx.fillText('起点', start[0] + 16, start[1] - 2);
  ctx.fillStyle = '#ff4d4d';
  ctx.fillText('终点', end[0] + 16, end[1] - 2);

  if (hasAlt){
    var lx = offsetX + 10, ly = offsetY + 10;
    ctx.fillStyle = 'rgba(8,13,22,.75)';
    ctx.fillRect(lx - 4, ly - 4, 118, 24);
    ctx.strokeStyle = 'rgba(90,120,160,.3)';
    ctx.strokeRect(lx - 4, ly - 4, 118, 24);
    ctx.font = 'bold 10px "SF Mono", monospace';
    ctx.fillStyle = '#7f92aa';
    ctx.textAlign = 'left';
    ctx.fillText('ALT', lx + 2, ly + 8);
    ctx.fillStyle = '#5ab4ff';
    ctx.textAlign = 'right';
    ctx.fillText(Math.round(altMax) + ' ft', lx + 110, ly + 8);
  }
}

/* =========================================================
   载入文件
   ========================================================= */
function handleFile(file){
  var statusEl = $('fileStatus');
  statusEl.className = 'show';
  statusEl.textContent = '正在读取 ' + file.name + ' ...';

  var reader = new FileReader();
  reader.onload = function(){
    var text = String(reader.result);
    var json;
    try {
      json = JSON.parse(text);
    } catch(e){
      statusEl.className = 'show err';
      statusEl.innerHTML = '<div>⚠ JSON 解析失败</div><div style="margin-top:4px">' + escapeHtml(e.message) + '</div>';
      toast('JSON 解析失败', 'err');
      return;
    }

    try {
      var isGeoFS = json && Array.isArray(json.tape);
      var isLNFDR = json && json.format === 'LNFDR';

      if (!isGeoFS && !isLNFDR){
        throw new Error('未识别的格式');
      }

      var detectedMode = isGeoFS ? 'g2l' : 'l2g';
      if (appState.mode !== detectedMode) setMode(detectedMode, true);

      var result = isGeoFS ? parseGeoFSTape(json) : parseLNFDR(json);
      appState.records = result.records;
      appState.aircraft = result.aircraft;
      appState.available = result.available;
      appState.totalDuration = result.totalDuration;
      appState.sourceMeta = result.sourceMeta || null;
      appState.sourceInfo = result.sourceInfo || null;

      var defaultWindow = Math.min(result.totalDuration, 1800);
      appState.windowSize = Math.max(5, defaultWindow);

      onDataLoaded(file, isGeoFS ? 'GeoFS' : 'LNFDR');

      var avail = result.available;
      var lines = [];
      lines.push('<div><span class="lbl">文件</span> <span class="val">' + escapeHtml(file.name) + '</span></div>');
      lines.push('<div><span class="lbl">来源格式</span> <span class="val hl">' + (isGeoFS ? 'GeoFS tape' : 'LNFDR') + '</span></div>');
      if (result.aircraft) lines.push('<div><span class="lbl">机型</span> <span class="val hl">' + escapeHtml(result.aircraft) + '</span></div>');
      lines.push('<div><span class="lbl">数据点数</span> <span class="val">' + result.records.length.toLocaleString() + '</span></div>');
      lines.push('<div><span class="lbl">总时长</span> <span class="val hl">' + fmtTime(result.totalDuration) + '</span></div>');
      if (isGeoFS){
        lines.push('<div><span class="lbl">经纬度</span> <span class="val">' + avail.lat + ' 有效点</span></div>');
      }
      lines.push('<div><span class="lbl">高度</span> <span class="val">' + avail.alt + ' 有效点</span></div>');
      lines.push('<div><span class="lbl">航向</span> <span class="val">' + avail.hdg + ' 有效点</span></div>');
      lines.push('<div><span class="lbl">速度</span> <span class="val">' + avail.spd + ' 有效点</span></div>');
      lines.push('<div><span class="lbl">俯仰/滚转</span> <span class="val">' + avail.pitch + ' / ' + avail.roll + '</span></div>');
      statusEl.className = 'show ok';
      statusEl.innerHTML = lines.join('');

      toast('已解析 ' + result.records.length.toLocaleString() + ' 点 · ' + (isGeoFS ? 'GeoFS' : 'LNFDR'), 'ok');

    } catch(err){
      console.error(err);
      statusEl.className = 'show err';
      statusEl.innerHTML = '<div>⚠ ' + escapeHtml(err.message) + '</div>';
      toast('解析失败：' + err.message, 'err');
    }
  };
  reader.onerror = function(){
    statusEl.className = 'show err';
    statusEl.textContent = '文件读取失败';
    toast('文件读取失败', 'err');
  };
  reader.readAsText(file);
}

function onDataLoaded(file, sourceLabel){
  var airInput = $('fAircraft');
  if (appState.aircraft){
    airInput.value = appState.aircraft;
  } else if (appState.sourceMeta && appState.sourceMeta.aircraftType){
    airInput.value = appState.sourceMeta.aircraftType;
  } else {
    airInput.value = '';
    airInput.placeholder = '（未自动识别，请手动输入）';
  }

  if (appState.sourceMeta){
    var m = appState.sourceMeta;
    if (m.tailNumber   && !$('fTail').value)     $('fTail').value = m.tailNumber;
    if (m.flightNumber && !$('fFlight').value)   $('fFlight').value = m.flightNumber;
    if (m.date)                                  $('fDate').value = m.date;
    if (m.operator     && !$('fOperator').value) $('fOperator').value = m.operator;
  }

  var dateInput = $('fDate');
  if (!dateInput.value){
    dateInput.value = new Date().toISOString().slice(0, 10);
  }

  var slider = $('windowSlider');
  slider.disabled = false;
  slider.min = 5;
  slider.max = Math.max(5, Math.round(appState.totalDuration));
  slider.value = Math.round(appState.windowSize);
  slider.step = appState.totalDuration > 1000 ? 5 : 1;
  updateSliderVisual(slider);

  $('windowMaxHint').textContent = '最大 ' + fmtMinute(appState.totalDuration);
  updateWindowLabel();
  updateIntervalLabel();

  $('btnExport').disabled = false;
  updatePreview();
}

function updateWindowLabel(){
  var v = appState.windowSize;
  var el = $('windowVal');
  if (v >= 60){
    el.textContent = (v/60).toFixed(v >= 600 ? 0 : 1) + ' min';
  } else {
    el.textContent = v.toFixed(0) + ' s';
  }
}

function updateIntervalLabel(){
  $('intervalVal').textContent = appState.interval.toFixed(1) + ' s';
}

function updateSliderVisual(slider){
  var min = parseFloat(slider.min) || 0;
  var max = parseFloat(slider.max) || 1;
  var val = parseFloat(slider.value) || 0;
  var pct = max > min ? ((val - min) / (max - min)) * 100 : 0;
  slider.style.setProperty('--p', pct + '%');
}

