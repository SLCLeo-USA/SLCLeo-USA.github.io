    var isTo=G.menuTo&&G.menuTo.id===c2.id;
    var isHov=menuHover&&menuHover.id===c2.id;
    if(isFrom||isTo){
      ctx.beginPath();
      ctx.arc(cx2,cy2,9+Math.sin(G.time*3)*1.5,0,7);
      ctx.fillStyle=isFrom?'rgba(110,198,255,0.16)':'rgba(255,159,90,0.16)';
      ctx.fill();
    }
    ctx.beginPath();
    ctx.arc(cx2,cy2,isFrom||isTo?5:(isHov?4.6:3),0,7);
    ctx.fillStyle=isFrom?'#6ec6ff':(isTo?'#ff9f5a':(isHov?'#ffffff':'rgba(190,215,255,0.48)'));
    ctx.fill();
    if(isFrom||isTo){ctx.strokeStyle='rgba(255,255,255,0.6)';ctx.lineWidth=1.5;ctx.stroke();}
    if(isFrom||isTo||isHov){
      ctx.textAlign='center';
      ctx.font='bold 10px system-ui,sans-serif';
