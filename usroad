function displayMiles(){return G.totalMilesDriven;}
function totalDisplayMiles(){return G.route?G.route.totalMiles:0;}

function drawHUD(){
  var route=G.route;
  if(!route) return;
  var prog=clamp(G.camZ/route.totalWorld,0,1);

  // ── 顶部中央：进度条 ──
  var barW=W-500,barH=6;
  var barX=(W-barW)/2,barY=28;

  // 阴影
  ctx.fillStyle='rgba(0,0,0,0.5)';
  roundRect(barX-6,barY-6,barW+12,barH+12,8);ctx.fill();
  // 底槽
  ctx.fillStyle='rgba(255,255,255,0.10)';
  roundRect(barX,barY,barW,barH,4);ctx.fill();
  // 进度
  var g=ctx.createLinearGradient(barX,0,barX+barW,0);
  g.addColorStop(0,'#6ec6ff');g.addColorStop(0.5,'#ffd166');g.addColorStop(1,'#ff8a5c');
  ctx.save();
  ctx.beginPath();
  roundRect(barX,barY,Math.max(2,barW*prog),barH,4);
  ctx.fillStyle=g;ctx.fill();
  ctx.restore();
  // 站点刻度
  for(var i=1;i<route.segments.length;i++){
    var seg=route.segments[i];
    var x=barX+barW*(seg.worldStart/route.totalWorld);
    ctx.beginPath();ctx.arc(x,barY+barH/2,3.5,0,7);
    ctx.fillStyle='rgba(255,255,255,0.55)';ctx.fill();
  }
  // 起点终点
  ctx.textBaseline='middle';
  ctx.font='bold 11px system-ui,sans-serif';
  ctx.textAlign='left';
  ctx.fillStyle='rgba(255,255,255,0.85)';
  ctx.fillText(route.fromCity.name,barX,barY-14);
  ctx.textAlign='right';
  ctx.fillText(route.toCity.name,barX+barW,barY-14);
  // 里程
  ctx.textAlign='center';
  ctx.font='bold 10px system-ui,sans-serif';
  ctx.fillStyle='rgba(255,255,255,0.5)';
  ctx.fillText(Math.round(displayMiles())+' / '+Math.round(totalDisplayMiles())+' 英里',W/2,barY+20);

  // ── 右上：视角按钮 ──
  var vx=W-270,vy=20,vw=250,vh=34;
  ctx.fillStyle='rgba(0,0,0,0.42)';
  roundRect(vx,vy,vw,vh,10);ctx.fill();
  ctx.strokeStyle='rgba(120,170,255,0.25)';ctx.lineWidth=1;
  roundRect(vx,vy,vw,vh,10);ctx.stroke();
  for(var vi=0;vi<VIEW_MODES.length;vi++){
    var vm=VIEW_MODES[vi];
    var vbx=vx+5+vi*(vw-10)/4,vby=vy+4,vbw=(vw-10)/4-3,vbh=vh-8;
    var vActive=G.viewIdx===vi;
    if(vActive){
      var ag=ctx.createLinearGradient(vbx,vby,vbx,vby+vbh);
      ag.addColorStop(0,'rgba(110,198,255,0.5)');
      ag.addColorStop(1,'rgba(110,198,255,0.2)');
      ctx.fillStyle=ag;
      roundRect(vbx,vby,vbw,vbh,6);ctx.fill();
      ctx.strokeStyle='rgba(140,215,255,0.85)';ctx.lineWidth=1.3;
      roundRect(vbx,vby,vbw,vbh,6);ctx.stroke();
    }
    ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.font='bold 9.5px system-ui,sans-serif';
    ctx.fillStyle=vActive?'#ffffff':'rgba(255,255,255,0.55)';
    ctx.fillText(vm.name,vbx+vbw/2,vby+vbh/2);
  }

  // ── 左下：速度表 ──
  var mph=Math.round(G.speed*2.2);
  var gaugeX=82,gaugeY=H-82,gaugeR=46;

  // 圆环背景
  ctx.beginPath();
  ctx.arc(gaugeX,gaugeY,gaugeR,Math.PI*0.78,Math.PI*2.22);
  ctx.strokeStyle='rgba(0,0,0,0.5)';ctx.lineWidth=10;ctx.stroke();
  ctx.beginPath();
  ctx.arc(gaugeX,gaugeY,gaugeR,Math.PI*0.78,Math.PI*2.22);
  ctx.strokeStyle='rgba(255,255,255,0.10)';ctx.lineWidth=7;ctx.stroke();

  // 速度环
  var spdRatio=clamp(G.speed/SPEED_MAX,0,1);
  var grad=ctx.createLinearGradient(gaugeX-gaugeR,0,gaugeX+gaugeR,0);
  grad.addColorStop(0,'#4ade80');grad.addColorStop(0.6,'#ffd166');grad.addColorStop(1,'#ff4d4d');
  ctx.beginPath();
  ctx.arc(gaugeX,gaugeY,gaugeR,Math.PI*0.78,Math.PI*0.78+Math.PI*1.44*spdRatio);
  ctx.strokeStyle=grad;ctx.lineWidth=7;ctx.lineCap='round';ctx.stroke();ctx.lineCap='butt';

  // 速度数字
  ctx.textAlign='center';ctx.textBaseline='middle';
  ctx.fillStyle='rgba(0,0,0,0.4)';
  ctx.font='bold 27px system-ui,sans-serif';
  ctx.fillText(mph,gaugeX+1,gaugeY);
  ctx.fillStyle='#ffffff';
  ctx.font='bold 26px system-ui,sans-serif';
  ctx.fillText(mph,gaugeX,gaugeY-2);
  ctx.font='bold 9px system-ui,sans-serif';
  ctx.fillStyle='rgba(255,255,255,0.55)';
  ctx.fillText('MPH',gaugeX,gaugeY+16);

  // ── 油量 ──
  var fx=152,fy=H-92,fw=170,fh=12;
  // 背景槽
  ctx.fillStyle='rgba(0,0,0,0.42)';
  roundRect(fx-2,fy-2,fw+4,fh+4,8);ctx.fill();
  ctx.fillStyle='rgba(255,255,255,0.10)';
  roundRect(fx,fy,fw,fh,5);ctx.fill();
  var fRatio=G.fuel/100;
  var fuelColor='#4ade80';
  if(fRatio<0.5) fuelColor='#ffd166';
  if(fRatio<0.22) fuelColor=(Math.sin(G.time*14)>0)?'#ff4d4d':'#ff8a5c';
  ctx.save();
  ctx.beginPath();roundRect(fx+2,fy+2,(fw-4)*fRatio,fh-4,3);
  ctx.fillStyle=fuelColor;ctx.fill();
  ctx.restore();
  // 标签
  ctx.textAlign='left';ctx.textBaseline='middle';
  ctx.font='bold 10.5px system-ui,sans-serif';
  ctx.fillStyle='rgba(255,255,255,0.55)';
  ctx.fillText('⛽ 燃油',fx,fy-12);
  ctx.textAlign='right';
  ctx.fillStyle='rgba(255,255,255,0.9)';
  ctx.fillText(Math.ceil(G.fuel)+'%',fx+fw,fy-12);
  if(G.refueling){
    ctx.textAlign='center';
    ctx.font='bold 12px system-ui,sans-serif';
    ctx.fillStyle='#6ee7a0';
    ctx.fillText('正在加油…',fx+fw/2,fy+26);
  }

  // ── 右下：信息面板 ──
  var iy=MINI_Y-76;
  // 模式
  var modeLabel=G.driveMode==='casual'?'标准模式':(G.driveMode==='real'?'真实模式':'自由模式');
  var modeColor=G.driveMode==='casual'?'#6ec6ff':(G.driveMode==='real'?'#ffd166':'#6ee7a0');
  ctx.textAlign='right';ctx.textBaseline='middle';
  ctx.font='bold 10px system-ui,sans-serif';
  ctx.fillStyle='rgba(0,0,0,0.5)';
  roundRect(W-120,iy-8,100,18,5);ctx.fill();
  ctx.fillStyle=modeColor;
  ctx.fillText(modeLabel,W-20,iy);

  // 下一站信息
  var segs=route.segments;
  var curSeg=segAtWorld(route,G.camZ);
  if(curSeg){
    var segIdx=segs.indexOf(curSeg);
    var nextSeg=segs[segIdx+1];
    var targetCity=nextSeg?CITY_MAP[nextSeg.to]:CITY_MAP[curSeg.to];
    var segProgress=(G.camZ-curSeg.worldStart)/curSeg.worldLen;
    var remainMi=Math.max(0,Math.round(curSeg.miles*(1-segProgress)));

    // 面板
    ctx.fillStyle='rgba(0,0,0,0.45)';
    roundRect(W-240,iy+18,220,62,10);ctx.fill();
    ctx.strokeStyle='rgba(120,170,255,0.15)';ctx.lineWidth=1;
    roundRect(W-240,iy+18,220,62,10);ctx.stroke();

    ctx.textAlign='left';
    ctx.font='bold 9px system-ui,sans-serif';
    ctx.fillStyle='rgba(255,255,255,0.42)';
    ctx.fillText('下一站',W-228,iy+32);

    ctx.font='bold 18px system-ui,sans-serif';
    ctx.fillStyle='#ffffff';
    ctx.fillText(targetCity.name,W-228,iy+52);

    ctx.textAlign='right';
    ctx.font='bold 15px system-ui,sans-serif';
    ctx.fillStyle='#ffd166';
    ctx.fillText(remainMi,W-28,iy+52);
    ctx.font='bold 9px system-ui,sans-serif';
    ctx.fillStyle='rgba(255,255,255,0.5)';
    ctx.fillText('英里',W-28,iy+68);

    // 公路编号
    ctx.textAlign='left';
    ctx.font='bold 10px system-ui,sans-serif';
    ctx.fillStyle='rgba(110,198,255,0.75)';
    ctx.fillText(curSeg.name,W-228,iy+70);
  }

  // ── 匝道提示 ──
  if(G.activeExit){
    var pulse=0.6+Math.sin(G.time*4)*0.4;
    var msg='↘ 前方匝道 · '+G.activeExit.city.name+' · 进入最右车道';
    ctx.font='bold 14px system-ui,sans-serif';
    var tw=ctx.measureText(msg).width;
    ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.fillStyle='rgba(6,15,25,0.75)';
    roundRect(W/2-tw/2-24,H-190,tw+48,40,12);ctx.fill();
    ctx.strokeStyle='rgba(110,231,160,'+(0.4+pulse*0.4)+')';
    ctx.lineWidth=1.5;
    roundRect(W/2-tw/2-24,H-190,tw+48,40,12);ctx.stroke();
    ctx.fillStyle='rgba(110,231,160,'+pulse+')';
    ctx.fillText(msg,W/2,H-170);
  }

  // ── 双闪提示 ──
  if(G.stoppedTimer>2){
    var blink=(G.time*4)%2>1;
    ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.font='bold 14px system-ui,sans-serif';
    ctx.fillStyle=blink?'#ffd166':'rgba(255,209,102,0.4)';
    ctx.fillText('🚨 双闪 · 靠边停车中',W/2,H-220);
  }

  // ── 自动驾驶 ──
  if(G.autoDrive){
    var pulse2=0.6+Math.sin(G.time*3)*0.4;
    ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.font='bold 12px system-ui,sans-serif';
    ctx.globalAlpha=pulse2;
    ctx.fillStyle='#6ee7a0';
    ctx.fillText('● 自动驾驶运行中',W/2,H-150);
    ctx.globalAlpha=1;
  }

  // ── 通知 ──
  if(G.notif){
    var a=Math.min(1,G.notif.t/0.6)*Math.min(1,(3.2-G.notif.t)/0.4);
    ctx.globalAlpha=clamp(a,0,1);
    ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.font='bold 22px system-ui,sans-serif';
    var tw=ctx.measureText(G.notif.text).width;
    ctx.fillStyle='rgba(10,14,22,0.72)';
    roundRect(W/2-tw/2-32,H*0.24-26,tw+64,52,26);ctx.fill();
    ctx.strokeStyle='rgba(255,255,255,0.15)';ctx.lineWidth=1;
    roundRect(W/2-tw/2-32,H*0.24-26,tw+64,52,26);ctx.stroke();
    ctx.fillStyle='#fff';
    ctx.fillText(G.notif.text,W/2,H*0.24);
    ctx.globalAlpha=1;
  }

  // ── 油量低警告 ──
  if(G.fuel<20&&G.mode==='playing'){
    var wa=(Math.sin(G.time*7)*0.5+0.5)*0.14;
    ctx.fillStyle='rgba(255,60,50,'+wa+')';
    ctx.fillRect(0,0,W,H);
  }

  // ── 暗角 ──
  var vg=ctx.createRadialGradient(W/2,H/2,H*0.42,W/2,H/2,H*0.98);
  vg.addColorStop(0,'rgba(0,0,0,0)');
  vg.addColorStop(1,'rgba(0,0,0,0.45)');
  ctx.fillStyle=vg;ctx.fillRect(0,0,W,H);

  // ── REC 指示 ──
  var blinkRec=(G.time*1.2)%2>1;
  ctx.globalAlpha=blinkRec?0.7:0.25;
  ctx.fillStyle='#ff4444';
  ctx.beginPath();ctx.arc(28,28,5.5,0,7);ctx.fill();
  ctx.globalAlpha=0.45;
  ctx.fillStyle='#ffffff';
  ctx.font='bold 11px monospace,system-ui,sans-serif';
  ctx.textAlign='left';ctx.textBaseline='middle';
  ctx.fillText('REC',42,28);
  ctx.globalAlpha=1;

  drawMiniMap();
}

