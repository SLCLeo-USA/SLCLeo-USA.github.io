var MINI_W=290,MINI_H=170;
var MINI_X=W-MINI_W-20,MINI_Y=H-MINI_H-20;
var MN_LNG_MIN=-126,MN_LNG_MAX=-66,MN_LAT_MIN=24,MN_LAT_MAX=50;
function mnX(lng){return MINI_X+22+(lng-MN_LNG_MIN)/(MN_LNG_MAX-MN_LNG_MIN)*(MINI_W-44);}
function mnY(lat){return MINI_Y+26+(MN_LAT_MAX-lat)/(MN_LAT_MAX-MN_LAT_MIN)*(MINI_H-50);}
var US_OUTLINE=[
  [-124.7,48.4],[-124.2,43.0],[-124.4,40.4],[-122.4,37.8],[-121.0,35.5],
  [-118.4,34.0],[-117.1,32.5],[-114.7,32.7],[-111.0,31.3],[-108.2,31.3],
  [-106.5,31.8],[-103.1,29.0],[-101.4,29.8],[-99.1,26.4],[-97.1,25.9],
  [-95.0,29.0],[-90.1,29.2],[-88.0,30.4],[-84.0,30.0],[-82.7,27.9],
  [-81.1,25.1],[-80.1,25.8],[-80.5,28.5],[-81.5,30.7],[-79.5,33.0],
  [-77.0,34.7],[-75.5,35.8],[-75.9,38.0],[-74.0,40.6],[-71.0,41.5],
  [-70.0,43.0],[-67.0,44.8],[-69.0,47.0],[-71.5,45.0],[-76.5,44.0],
  [-79.0,43.3],[-82.5,41.7],[-83.1,42.3],[-82.5,45.0],[-84.5,46.5],
  [-88.0,48.2],[-95.0,49.0],[-110.0,49.0],[-122.8,49.0]
];

function drawMiniMap(){
  if(!G.miniMapVisible||!G.route) return;

  // 面板阴影
  ctx.save();
  ctx.shadowColor='rgba(0,0,0,0.6)';ctx.shadowBlur=20;ctx.shadowOffsetY=4;
  ctx.fillStyle='rgba(10,14,22,0.88)';
  roundRect(MINI_X,MINI_Y,MINI_W,MINI_H,12);ctx.fill();
  ctx.restore();
  ctx.strokeStyle='rgba(140,180,255,0.35)';ctx.lineWidth=1.2;
  roundRect(MINI_X,MINI_Y,MINI_W,MINI_H,12);ctx.stroke();

  // 标题栏
  ctx.fillStyle='rgba(110,198,255,0.12)';
  roundRect(MINI_X,MINI_Y,MINI_W,22,12);ctx.fill();
  ctx.fillStyle='rgba(10,14,22,0.88)';
  ctx.fillRect(MINI_X,MINI_Y+14,MINI_W,8);
  ctx.font='bold 10px system-ui,sans-serif';
  ctx.fillStyle='rgba(180,215,255,0.9)';
  ctx.textAlign='left';ctx.textBaseline='middle';
  ctx.fillText('◈ 行车地图',MINI_X+12,MINI_Y+11);
  ctx.textAlign='right';
  ctx.fillStyle='rgba(140,180,255,0.5)';
  ctx.font='bold 9px system-ui,sans-serif';
  ctx.fillText('M 隐藏',MINI_X+MINI_W-12,MINI_Y+11);

  // 美国轮廓
  ctx.beginPath();
  for(var i=0;i<US_OUTLINE.length;i++){
    var p=US_OUTLINE[i];
    var x=mnX(p[0]),y=mnY(p[1]);
    if(i===0) ctx.moveTo(x,y); else ctx.lineTo(x,y);
  }
  ctx.closePath();
  ctx.fillStyle='rgba(90,140,220,0.10)';ctx.fill();
  ctx.strokeStyle='rgba(120,170,255,0.4)';ctx.lineWidth=1.1;ctx.stroke();

  // 完整路线
  var segs=G.route.segments;
  ctx.strokeStyle='rgba(255,255,255,0.20)';
  ctx.lineWidth=2;
  ctx.beginPath();
  for(var s=0;s<segs.length;s++){
    var a=CITY_MAP[segs[s].from],b=CITY_MAP[segs[s].to];
    if(!a||!b) continue;
    if(s===0) ctx.moveTo(mnX(a.lng),mnY(a.lat));
    ctx.lineTo(mnX(b.lng),mnY(b.lat));
  }
  ctx.stroke();

  // 已走轨迹
  var curSeg=segAtWorld(G.route,G.camZ);
  if(!curSeg) return;
  var prog=clamp((G.camZ-curSeg.worldStart)/curSeg.worldLen,0,1);

  ctx.strokeStyle='rgba(110,231,160,0.95)';
  ctx.lineWidth=2.8;
  ctx.beginPath();
  for(var s2=0;s2<segs.length;s2++){
    var sa=CITY_MAP[segs[s2].from],sb=CITY_MAP[segs[s2].to];
    if(!sa||!sb) continue;
    if(segs[s2]===curSeg){
      if(s2===0) ctx.moveTo(mnX(sa.lng),mnY(sa.lat));
      else ctx.moveTo(mnX(sa.lng),mnY(sa.lat));
      var mx=lerp(mnX(sa.lng),mnX(sb.lng),prog);
      var my=lerp(mnY(sa.lat),mnY(sb.lat),prog);
      ctx.lineTo(mx,my);
      break;
    }
    if(s2===0) ctx.moveTo(mnX(sa.lng),mnY(sa.lat));
    ctx.lineTo(mnX(sb.lng),mnY(sb.lat));
  }
  ctx.stroke();

  // 城市点
  for(var ci=0;ci<CITIES.length;ci++){
    var c=CITIES[ci];
    var cx=mnX(c.lng),cy=mnY(c.lat);
    var isFrom=G.route.fromCity.id===c.id;
    var isTo=G.route.toCity.id===c.id;
    var isCur=(c.id===curSeg.from||c.id===curSeg.to);
    if(isFrom||isTo||isCur){
      ctx.beginPath();
      ctx.arc(cx,cy,isFrom||isTo?4:(isCur?3.5:2),0,7);
      ctx.fillStyle=isFrom?'#6ec6ff':(isTo?'#ff9f5a':'#ffd166');
      ctx.fill();
      if(isFrom||isTo){
        ctx.strokeStyle='rgba(255,255,255,0.8)';ctx.lineWidth=1;
        ctx.stroke();
      }
    } else {
      ctx.beginPath();
      ctx.arc(cx,cy,1.5,0,7);
      ctx.fillStyle='rgba(190,215,255,0.35)';
      ctx.fill();
    }
  }

  // 当前位置脉冲
  var a2=CITY_MAP[curSeg.from],b2=CITY_MAP[curSeg.to];
  if(a2&&b2){
    var px=lerp(mnX(a2.lng),mnX(b2.lng),prog);
    var py=lerp(mnY(a2.lat),mnY(b2.lat),prog);
    var pulse=0.6+Math.sin(G.time*5)*0.4;
    ctx.fillStyle='rgba(255,220,120,'+pulse*0.4+')';
    ctx.beginPath();ctx.arc(px,py,9,0,7);ctx.fill();
    ctx.fillStyle='rgba(255,220,120,0.9)';
    ctx.beginPath();ctx.arc(px,py,4,0,7);ctx.fill();
    ctx.fillStyle='#ffffff';
    ctx.beginPath();ctx.arc(px,py,2,0,7);ctx.fill();
  }
}

