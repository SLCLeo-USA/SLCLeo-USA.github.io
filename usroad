function currentLandscape(){
  if(!G.route) return LANDSCAPE.plains;
  var seg=segAtWorld(G.route,G.camZ);
  if(!seg) return LANDSCAPE.plains;
  var t=clamp((G.camZ-seg.worldStart)/seg.worldLen,0,1);
  var fromCity=CITY_MAP[seg.from],toCity=CITY_MAP[seg.to];
  if(!fromCity||!toCity) return LANDSCAPE.plains;
  var fromL=LANDSCAPE[THEME_TO_LAND[fromCity.theme]||'plains'];
  var toL=LANDSCAPE[THEME_TO_LAND[toCity.theme]||'plains'];
  return {
    h:lerp(fromL.h,toL.h,t),
    far:lerpC3(fromL.far,toL.far,t),mid:lerpC3(fromL.mid,toL.mid,t),near:lerpC3(fromL.near,toL.near,t),
    snow:fromL.snow||toL.snow,tree:fromL.tree,
    ground:lerpC3(fromL.ground,toL.ground,t),
    canyon:fromCity.theme==='canyon'||toCity.theme==='canyon',
    mountain:fromCity.theme==='mountain'||toCity.theme==='mountain'
  };
}

