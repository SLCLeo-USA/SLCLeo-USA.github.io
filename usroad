    ctx.globalAlpha=1;
    ctx.save();
    ctx.shadowColor='rgba(255,190,90,'+(0.5+pulse*0.5)+')';
    ctx.shadowBlur=30+pulse*24;
    var bg2=ctx.createLinearGradient(bx,by,bx,by+bh);
    bg2.addColorStop(0,'#ffd166');bg2.addColorStop(1,'#f79b3c');
    ctx.fillStyle=bg2;
    roundRect(bx,by,bw,bh,26);ctx.fill();
    ctx.restore();
    ctx.strokeStyle='rgba(255,255,255,0.4)';ctx.lineWidth=1.5;
    roundRect(bx,by,bw,bh,26);ctx.stroke();
    ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.fillStyle='#3a2208';
    ctx.font='bold 20px system-ui,sans-serif';
    ctx.fillText('出 发',bx+bw/2,by+bh/2+1);
    ctx.textBaseline='alphabetic';
  } else if(st==='to'&&G.menuFrom){
    ctx.font='13px system-ui,sans-serif';
    ctx.fillStyle='rgba(255,255,255,0.5)';
    ctx.fillText('出发地：',IX+20,IY+66);
    ctx.fillStyle='#6ec6ff';
    ctx.font='bold 18px system-ui,sans-serif';
    ctx.fillText(G.menuFrom.name,IX+20+62,IY+68);
    ctx.font='12px system-ui,sans-serif';
    ctx.fillStyle='rgba(255,255,255,0.3)';
    ctx.fillText('可从地图或右侧列表选择目的城市',IX+20,IY+100);
  } else {
    ctx.font='12px system-ui,sans-serif';
    ctx.fillStyle='rgba(255,255,255,0.3)';
    if(G.driveMode==='free'){
      ctx.fillText('自由模式：选择起点即可出发',IX+20,IY+60);
      ctx.fillText('到达城市后通过匝道进入下一条公路',IX+20,IY+84);
      ctx.fillText('总城市数：'+CITIES.length+' 座',IX+20,IY+108);
    } else {
      ctx.fillText('真实美国公路网 · 支持任意两城规划',IX+20,IY+60);
      ctx.fillText('总城市数：'+CITIES.length+' 座',IX+20,IY+84);
      ctx.fillText('公路网：'+HIGHWAYS.length+' 条路段',IX+20,IY+108);
    }
  }

  var LX=626,LY=336,LW=302,LH=220;
  ctx.fillStyle='rgba(255,255,255,0.022)';
  roundRect(LX,LY,LW,LH,14);ctx.fill();
  ctx.strokeStyle='rgba(120,170,255,0.09)';ctx.lineWidth=1;
  roundRect(LX,LY,LW,LH,14);ctx.stroke();
  ctx.textAlign='left';
  ctx.font='bold 12px system-ui,sans-serif';
  ctx.fillStyle='rgba(255,255,255,0.42)';
  ctx.fillText('城市列表',LX+16,LY+22);

  var rowH=15;
  var visibleRows=Math.floor((LH-50)/rowH);
  var startIdx=G.cityListScroll;
  var endIdx=Math.min(CITIES.length,startIdx+visibleRows*2);
  ctx.save();
  ctx.beginPath();
  ctx.rect(LX+8,LY+34,LW-16,LH-44);
  ctx.clip();
  var colW=(LW-32)/2;
  for(var li=startIdx;li<endIdx;li++){
    var c3=CITIES[li];
    var col=(li-startIdx)%2;
    var row=Math.floor((li-startIdx)/2);
    var rx=LX+16+col*colW;
    var ry=LY+42+row*rowH;
    var hov2=menuHover&&menuHover.id===c3.id;
    var isFrom2=G.menuFrom&&G.menuFrom.id===c3.id;
    var isTo2=G.menuTo&&G.menuTo.id===c3.id;
    if(hov2){
      ctx.fillStyle='rgba(255,255,255,0.055)';
      roundRect(rx-3,ry-8,colW-4,13,4);ctx.fill();
    }
    ctx.textAlign='left';
    ctx.font=(isFrom2||isTo2?'bold ':'')+'10px system-ui,sans-serif';
    ctx.fillStyle=isFrom2?'#6ec6ff':(isTo2?'#ff9f5a':(hov2?'#ffffff':'rgba(210,225,245,0.58)'));
