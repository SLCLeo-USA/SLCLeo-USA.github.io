var DAY_LEN=480;
var TIME_MAP={dawn:0.25,noon:0.5,dusk:0.75,night:0.95};
var SKY_KEYS=[
  {h:-1.00,top:[7,9,24],bot:[16,20,44],sun:[46,56,104]},
  {h:-0.20,top:[16,20,46],bot:[42,40,76],sun:[66,66,116]},
  {h:-0.04,top:[54,48,94],bot:[224,114,88],sun:[255,152,92]},
  {h:0.14,top:[86,140,206],bot:[240,194,162],sun:[255,224,154]},
  {h:0.42,top:[70,142,216],bot:[186,220,244],sun:[255,250,234]},
  {h:1.00,top:[56,130,214],bot:[174,210,242],sun:[255,255,248]}
];
function skyState(){
  var startT=TIME_MAP[G.startTime]||0.5;
  var dayT=(startT+G.time/DAY_LEN)%1;
  var ang=dayT*Math.PI*2-Math.PI*0.5;
  var h=Math.sin(ang);
  var sunX=W/2+Math.cos(ang)*W*0.60;
  var sunY=HORIZON_Y-h*200;
  var top=SKY_KEYS[0].top,bot=SKY_KEYS[0].bot,sc=SKY_KEYS[0].sun;
  for(var i=0;i<SKY_KEYS.length-1;i++){
    var a=SKY_KEYS[i],b=SKY_KEYS[i+1];
    if(h>=a.h&&h<=b.h){
      var t=(h-a.h)/(b.h-a.h||1);
      top=lerpC3(a.top,b.top,t);bot=lerpC3(a.bot,b.bot,t);sc=lerpC3(a.sun,b.sun,t);
      break;
    }
  }
  if(h>SKY_KEYS[SKY_KEYS.length-1].h){var l=SKY_KEYS[SKY_KEYS.length-1];top=l.top;bot=l.bot;sc=l.sun;}
  return {h:h,top:top,bot:bot,sunColor:sc,sunX:sunX,sunY:sunY,night:clamp(-h*1.8,0,1)};
}

