      var tHover=timeHover&&timeHover.id===tb.id;
      if(tActive){
        var tg2=ctx.createLinearGradient(tb.x,tb.y,tb.x,tb.y+tb.h);
        tg2.addColorStop(0,'rgba(255,209,102,0.30)');
        tg2.addColorStop(1,'rgba(255,159,90,0.12)');
        ctx.fillStyle=tg2;
      } else if(tHover){ctx.fillStyle='rgba(255,255,255,0.05)';}
      else {ctx.fillStyle='rgba(255,255,255,0.02)';}
      roundRect(tb.x,tb.y,tb.w,tb.h,10);ctx.fill();
      ctx.strokeStyle=tActive?'rgba(255,209,102,0.7)':(tHover?'rgba(255,255,255,0.18)':'rgba(255,255,255,0.07)');
      ctx.lineWidth=tActive?1.5:1;
      roundRect(tb.x,tb.y,tb.w,tb.h,10);ctx.stroke();
      ctx.textAlign='center';ctx.textBaseline='middle';
      ctx.font='bold 12px system-ui,sans-serif';
      ctx.fillStyle=tActive?'#ffd166':'rgba(255,255,255,0.6)';
      ctx.fillText(tb.name,tb.x+tb.w/2,tb.y+tb.h/2);
      ctx.textBaseline='alphabetic';
