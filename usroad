var MAP_X=30,MAP_Y=108,MAP_W=560,MAP_H=300;
var LNG_MIN=-128,LNG_MAX=-64,LAT_MIN=23,LAT_MAX=50;
function toMapX(lng){return MAP_X+(lng-LNG_MIN)/(LNG_MAX-LNG_MIN)*MAP_W;}
function toMapY(lat){return MAP_Y+(LAT_MAX-lat)/(LAT_MAX-LAT_MIN)*MAP_H;}

var menuHover=null,modeHover=null,timeHover=null;
function cityAtPoint(mx,my){
  for(var i=0;i<CITIES.length;i++){
    var c=CITIES[i];
    var cx=toMapX(c.lng),cy=toMapY(c.lat);
    if(Math.hypot(mx-cx,my-cy)<9) return c;
  }
  return null;
}
var MODE_BUTTONS=[
  {id:'casual',name:'标准模式',desc:'1:5.5 距离 · 快速穿越',x:626,y:100,w:302,h:50},
  {id:'real',name:'真实模式',desc:'1:22 距离 · 可选出发时间',x:626,y:158,w:302,h:50},
  {id:'free',name:'自由模式',desc:'立交枢纽 · 自由探索',x:626,y:216,w:302,h:50}
];
var TIME_BUTTONS=[
  {id:'dawn',name:'黎明',x:626,y:280,w:70,h:38},
  {id:'noon',name:'正午',x:704,y:280,w:70,h:38},
  {id:'dusk',name:'黄昏',x:782,y:280,w:70,h:38},
  {id:'night',name:'夜晚',x:860,y:280,w:68,h:38}
];
function modeButtonAt(mx,my){
  for(var i=0;i<MODE_BUTTONS.length;i++){
    var b=MODE_BUTTONS[i];
    if(mx>=b.x&&mx<=b.x+b.w&&my>=b.y&&my<=b.y+b.h) return b;
  }
  return null;
}
function timeButtonAt(mx,my){
  if(G.driveMode!=='real') return null;
  for(var i=0;i<TIME_BUTTONS.length;i++){
    var b=TIME_BUTTONS[i];
    if(mx>=b.x&&mx<=b.x+b.w&&my>=b.y&&my<=b.y+b.h) return b;
  }
  return null;
}
function menuStage(){
  if(G.driveMode==='free') return G.menuFrom?'ready':'from';
  return !G.menuFrom?'from':(!G.menuTo?'to':'ready');
}

function drawMenu(){
  var bg=ctx.createLinearGradient(0,0,0,H);
  bg.addColorStop(0,'#0a1018');bg.addColorStop(0.5,'#0d1420');bg.addColorStop(1,'#080c14');
