  ctx.textAlign='left';
  ctx.font='bold 13px system-ui,sans-serif';
  ctx.fillStyle=titleCol;
  ctx.fillText(title,IX+20,IY+26);

  if(st==='ready'&&G.menuFrom){
    if(G.driveMode==='free'){
      ctx.font='bold 14px system-ui,sans-serif';
      ctx.fillStyle='rgba(255,255,255,0.88)';
      ctx.fillText('出发地：'+G.menuFrom.name,IX+20,IY+62);
      ctx.font='12px system-ui,sans-serif';
      ctx.fillStyle='rgba(190,215,255,0.65)';
      ctx.fillText('到达后将自动通过匝道进入相连公路',IX+20,IY+92);
    } else {
      var path2=shortestPath(G.menuFrom.id,G.menuTo.id);
      var route=buildRouteFromPath(path2,G.menuFrom,G.menuTo);
      var dReal=route?route.totalMiles:0;
      ctx.font='bold 14px system-ui,sans-serif';
      ctx.fillStyle='rgba(255,255,255,0.88)';
      ctx.fillText(G.menuFrom.name,IX+20,IY+56);
      ctx.fillStyle='rgba(255,255,255,0.3)';
      ctx.fillText('→',IX+20+54,IY+56);
      ctx.fillStyle='rgba(255,255,255,0.88)';
      ctx.fillText(G.menuTo.name,IX+20+76,IY+56);
      ctx.font='bold 11px system-ui,sans-serif';
      ctx.fillStyle='rgba(255,255,255,0.38)';
      ctx.fillText('全程',IX+20,IY+84);
      ctx.font='bold 26px system-ui,sans-serif';
      ctx.fillStyle='#ffd166';
      ctx.fillText(Math.round(dReal).toLocaleString(),IX+20+36,IY+90);
      if(route&&route.segments.length>1){
        ctx.font='bold 11px system-ui,sans-serif';
        ctx.fillStyle='rgba(255,255,255,0.38)';
