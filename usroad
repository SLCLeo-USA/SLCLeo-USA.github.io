  ctx.restore();

  ctx.textAlign='center';
  ctx.font='bold 11px system-ui,sans-serif';
  ctx.fillStyle='rgba(255,255,255,0.22)';
  ctx.fillText('Q 油门  A 刹车  ← → 转向  F 自动驾驶  V 视角  M 地图  滚轮翻页',W/2,H-14);
}

function drawFreeChoose(){
  var t=Math.min(1,G.arrivedT/0.5);
  ctx.fillStyle='rgba(6,10,20,'+(0.80*t)+')';ctx.fillRect(0,0,W,H);
  ctx.textAlign='center';ctx.textBaseline='alphabetic';
  ctx.font='bold 16px system-ui,sans-serif';
  ctx.fillStyle='rgba(255,255,255,0.5)';
  ctx.fillText('到达',W/2,H*0.13);
  ctx.font='bold 42px system-ui,sans-serif';
  var g=ctx.createLinearGradient(0,H*0.13+16,0,H*0.13+62);
  g.addColorStop(0,'#ffe9a8');g.addColorStop(1,'#ff9f5a');
  ctx.fillStyle=g;
  ctx.fillText(G.freeCity?G.freeCity.name:'',W/2,H*0.13+54);
  ctx.font='bold 13px system-ui,sans-serif';
  ctx.fillStyle='rgba(255,255,255,0.42)';
  ctx.fillText('选择要进入的公路',W/2,H*0.13+84);
  var opts=G.freeOptions||[];
  var cols=Math.min(3,opts.length);
  var bw=240,bh=74;
  var totalW=cols*bw+(cols-1)*16;
  var startX=(W-totalW)/2;
  var startY=H*0.13+112;
  for(var i=0;i<opts.length;i++){
    var o=opts[i];
    var col=i%cols,row=Math.floor(i/cols);
    var bx=startX+col*(bw+16);
    var by=startY+row*(bh+14);
    var hover=G.freeHoverIndex===i;
    var bg2=ctx.createLinearGradient(bx,by,bx,by+bh);
    if(hover){bg2.addColorStop(0,'rgba(110,198,255,0.22)');bg2.addColorStop(1,'rgba(110,198,255,0.08)');}
    else{bg2.addColorStop(0,'rgba(255,255,255,0.06)');bg2.addColorStop(1,'rgba(255,255,255,0.02)');}
    ctx.fillStyle=bg2;
    roundRect(bx,by,bw,bh,14);ctx.fill();
    ctx.strokeStyle=hover?'rgba(110,198,255,0.7)':'rgba(255,255,255,0.10)';
    ctx.lineWidth=hover?1.6:1;
    roundRect(bx,by,bw,bh,14);ctx.stroke();
    ctx.textAlign='left';
    ctx.font='bold 11px system-ui,sans-serif';
    ctx.fillStyle=hover?'#6ec6ff':'rgba(255,255,255,0.35)';
    ctx.fillText(o.highway,bx+18,by+24);
    ctx.font='bold 20px system-ui,sans-serif';
    ctx.fillStyle='#ffffff';
    ctx.fillText(o.name,bx+18,by+50);
    ctx.textAlign='right';
    ctx.font='bold 12px system-ui,sans-serif';
    ctx.fillStyle='rgba(255,255,255,0.45)';
    ctx.fillText(o.miles+' 英里',bx+bw-18,by+50);
    ctx.font='bold 10px system-ui,sans-serif';
    ctx.fillStyle='rgba(255,255,255,0.28)';
    ctx.fillText(o.state,bx+bw-18,by+24);
  }
  ctx.textAlign='center';
  ctx.font='bold 11px system-ui,sans-serif';
  ctx.fillStyle='rgba(255,255,255,0.22)';
  ctx.fillText('点击卡片进入该公路',W/2,H-30);
}

function drawArrived(){
  var t=Math.min(1,G.arrivedT/0.8);
  var ease=1-Math.pow(1-t,3);
  ctx.fillStyle='rgba(6,10,20,'+(0.78*ease)+')';ctx.fillRect(0,0,W,H);
  var cy=H*0.28*ease+46;
  ctx.textAlign='center';ctx.textBaseline='alphabetic';
  ctx.save();
  ctx.font='bold 54px system-ui,sans-serif';
  var g=ctx.createLinearGradient(0,cy-48,0,cy+10);
  g.addColorStop(0,'#ffe9a8');g.addColorStop(1,'#ff9f5a');
  ctx.fillStyle=g;
  ctx.shadowColor='rgba(255,190,90,0.55)';ctx.shadowBlur=30;
  ctx.fillText('抵达 '+G.route.toCity.name,W/2,cy);
  ctx.restore();
  ctx.font='bold 14px system-ui,sans-serif';
  ctx.fillStyle='rgba(255,255,255,0.5)';
  ctx.fillText(G.route.fromCity.name+'  →  '+G.route.toCity.name,W/2,cy+44);
  var pw=440,ph=170;
  var px=W/2-pw/2,py=H*0.46;
  ctx.fillStyle='rgba(255,255,255,0.05)';
  roundRect(px,py,pw,ph,18);ctx.fill();
  ctx.strokeStyle='rgba(255,255,255,0.09)';ctx.lineWidth=1;
  roundRect(px,py,pw,ph,18);ctx.stroke();
  var realMiles=G.route.totalMiles;
  var modeName=G.driveMode==='casual'?'标准模式':(G.driveMode==='real'?'真实模式':'自由模式');
  var rows=[
    ['模式',modeName],
    ['总里程',realMiles.toLocaleString()+' 英里'],
    ['途经路段',G.route.segments.length+' 段'],
    ['轨迹点数',G.trackPoints.length+' 点']
  ];
  ctx.font='bold 14px system-ui,sans-serif';
  for(var i=0;i<rows.length;i++){
    var ry=py+34+i*30;
    ctx.textAlign='left';
    ctx.fillStyle='rgba(255,255,255,0.42)';
    ctx.fillText(rows[i][0],px+36,ry);
    ctx.textAlign='right';
    ctx.fillStyle='#ffffff';
    ctx.fillText(rows[i][1],px+pw-36,ry);
  }
  var pulse=0.4+Math.sin(G.time*3)*0.35;
  ctx.globalAlpha=pulse*ease;
  ctx.textAlign='center';
  ctx.font='bold 15px system-ui,sans-serif';
  ctx.fillStyle='#ffffff';
  ctx.fillText('点击重新规划路线',W/2,H-60);
  ctx.globalAlpha=1;
}

// ═══════════════════════════════════════════════════════════════
//  输入
// ═══════════════════════════════════════════════════════════════
function getMouse(e){
  var r=cv.getBoundingClientRect();
  return{x:(e.clientX-r.left)/r.width*W,y:(e.clientY-r.top)/r.height*H};
}
function screenToLat(clientX){
  var r=cv.getBoundingClientRect();
  var gx=(clientX-r.left)/r.width*W;
  var s=FOCAL/PLAYER_Z;
  var lat=(gx-W/2)/s-roadOffset(PLAYER_Z)+G.camLat;
  return clamp(lat,-WALL_LAT,WALL_LAT);
}
function handleMenuClick(mx,my){
  var tb=timeButtonAt(mx,my);
  if(tb){G.startTime=tb.id;return;}
  var mb=modeButtonAt(mx,my);
  if(mb){G.driveMode=mb.id;if(mb.id==='free'&&G.menuTo) G.menuTo=null;return;}

  var LX=626,LY=336,LW=302,LH=220;
  if(mx>=LX&&mx<=LX+LW&&my>=LY&&my<=LY+LH){
    var rowH=15;
    var visibleRows=Math.floor((LH-50)/rowH);
    var startIdx=G.cityListScroll;
    var endIdx=Math.min(CITIES.length,startIdx+visibleRows*2);
    var colW=(LW-32)/2;
    for(var li=startIdx;li<endIdx;li++){
      var c=CITIES[li];
      var col=(li-startIdx)%2,row=Math.floor((li-startIdx)/2);
      var rx=LX+16+col*colW;
      var ry=LY+42+row*rowH;
      if(mx>=rx-4&&mx<=rx+colW-6&&my>=ry-9&&my<=ry+5){selectCity(c);return;}
    }
    return;
  }
  var st=menuStage();
  if(st==='ready'){
    var IX=30,IY=428,IW=560,IH=128;
    var bw=150,bh=52;
    var bx=IX+IW-bw-20,by=IY+IH-bh-16;
    if(mx>=bx&&mx<=bx+bw&&my>=by&&my<=by+bh){startGame();return;}
  }
  var cm=cityAtPoint(mx,my);
  if(cm){selectCity(cm);return;}
  if(my>MAP_Y&&my<MAP_Y+MAP_H&&mx>MAP_X&&mx<MAP_X+MAP_W){
    if(st==='ready'||st==='to'){G.menuFrom=null;G.menuTo=null;}
  }
}
function selectCity(c){
  var st=menuStage();
  if(st==='from'){G.menuFrom=c;G.menuTo=null;}
  else if(st==='to'){
    if(G.menuFrom&&G.menuFrom.id===c.id) return;
    G.menuTo=c;
  } else {G.menuFrom=c;G.menuTo=null;}
}
function startGame(){
  if(!G.menuFrom) return;
  if(G.driveMode==='free'){
    G.mode='free-choose';
    G.freeCity=G.menuFrom;
    G.arrivedT=0;G.camZ=0;G.speed=0;G.throttle=0;G.brake=0;
    G.lateralVel=0;G.steerInput=0;G.steerSmooth=0;
    G.playerLat=LANE_R[1];G.playerLane=1;G.targetLat=LANE_R[1];G.camLat=LANE_R[1];
    G.traffic=[];G.sceneries=[];G.signs=[];G.route=null;
    G.fuel=100;G.autoDrive=false;G.totalMilesDriven=0;
    G.nextTraffic=90;G.nextScen=25;
    var nbrs=GRAPH[G.menuFrom.id]||[];
    var opts=[];
    for(var i=0;i<nbrs.length;i++){
      var n=nbrs[i];
      var dest=CITY_MAP[n.to];
      if(!dest) continue;
      opts.push({id:n.to,name:dest.name,highway:n.name,miles:n.miles,state:dest.state});
    }
    G.freeOptions=opts;G.freeHoverIndex=-1;
    return;
  }
  if(!G.menuTo) return;
  var from=G.menuFrom,to=G.menuTo;
  var path=shortestPath(from.id,to.id);
  if(!path||!path.length) return;
  var route=buildRouteFromPath(path,from,to);
  var signs=[];
  var step=Math.max(300,route.totalWorld/12);
  for(var z=200;z<route.totalWorld-150;z+=step){
    var seg=segAtWorld(route,z);
    if(!seg) continue;
    var targetCity=CITY_MAP[seg.to];
    var segProgress=(z-seg.worldStart)/seg.worldLen;
    var remainMi=Math.max(0,Math.round(seg.miles*(1-segProgress)));
    signs.push({z:z,lat:Math.random()<0.5?14:-14,city:targetCity,distMi:remainMi});
  }
  resetRun(route,signs);
}
function resetRun(route,signs){
  G.mode='playing';
  G.camZ=0;G.speed=0;G.throttle=0;G.brake=0;
  G.lateralVel=0;G.steerInput=0;G.steerSmooth=0;
  G.playerLane=1;
  G.playerLat=LANE_R[1];G.targetLat=LANE_R[1];G.camLat=LANE_R[1];
  G.route=route;G.signs=signs;
  G.traffic=[];G.sceneries=[];
  G.nextTraffic=90;G.nextScen=25;
  G.notif={text:'出发 · '+route.fromCity.name,t:3.2};
  G.shake=0;G.arrivedT=0;G.time=0;
  G.fuel=100;G.totalMilesDriven=0;
  G.autoDrive=false;G.collisionCooldown=0;
  G.offRoadTime=0;G.offRoadWarned=false;
  G.hazardTimer=0;G.stoppedTimer=0;
  G.fadeAlpha=0.6;
  G.blinkers=0;G.blinkSide=0;
  G.exitZones=generateExitZones();
  G.activeExit=null;
  G.trackPoints=[];
}
function enterFreeRoad(optIndex){
  var o=G.freeOptions[optIndex];
  if(!o) return;
  var fromCity=G.freeCity;
  var toCity=CITY_MAP[o.id];
  if(!fromCity||!toCity) return;
  var edge={to:o.id,name:o.highway,miles:o.miles};
  var route=buildFreeRoute(fromCity,edge,toCity);
  var signs=[{z:route.totalWorld*0.42,lat:14,city:toCity,distMi:o.miles}];
  resetRun(route,signs);
}

window.addEventListener('keydown',function(e){
  keys[e.key]=true;
  if(['ArrowLeft','ArrowRight','ArrowUp','ArrowDown',' '].indexOf(e.key)>=0) e.preventDefault();
  if((e.key==='f'||e.key==='F')&&G.mode==='playing'){
    G.autoDrive=!G.autoDrive;
    G.notif={text:G.autoDrive?'自动驾驶 已开启':'手动驾驶',t:1.8};
  }
  if((e.key==='v'||e.key==='V')&&G.mode==='playing'){
    G.viewIdx=(G.viewIdx+1)%VIEW_MODES.length;
    G.notif={text:'视角 · '+VIEW_MODES[G.viewIdx].name,t:1.5};
  }
  if((e.key==='m'||e.key==='M')&&G.mode==='playing'){
    G.miniMapVisible=!G.miniMapVisible;
  }
  if(G.mode==='arrived'&&G.arrivedT>0.8&&(e.key===' '||e.key==='Enter')){
    G.mode='menu';G.menuFrom=null;G.menuTo=null;
  }
});
window.addEventListener('keyup',function(e){keys[e.key]=false;});

cv.addEventListener('wheel',function(e){
  if(G.mode==='menu'){
    var m=getMouse(e);
    var LX=626,LY=336,LW=302,LH=220;
    if(m.x>=LX&&m.x<=LX+LW&&m.y>=LY&&m.y<=LY+LH){
      var rowH=15;
      var visibleRows=Math.floor((LH-50)/rowH);
      G.cityListScroll=clamp(G.cityListScroll+Math.sign(e.deltaY)*visibleRows,0,Math.max(0,CITIES.length-visibleRows*2));
      e.preventDefault();
    }
  }
},{passive:false});

cv.addEventListener('pointerdown',function(e){
  var m=getMouse(e);
  if(G.mode==='menu'){handleMenuClick(m.x,m.y);return;}
  if(G.mode==='free-choose'){
    if(G.arrivedT>0.4){
      var opts=G.freeOptions||[];
      var cols=Math.min(3,opts.length);
      var bw=240,bh=74;
      var totalW=cols*bw+(cols-1)*16;
      var startX=(W-totalW)/2;
      var startY=H*0.13+112;
      for(var i=0;i<opts.length;i++){
        var col=i%cols,row=Math.floor(i/cols);
        var bx=startX+col*(bw+16);
        var by=startY+row*(bh+14);
        if(m.x>=bx&&m.x<=bx+bw&&m.y>=by&&m.y<=by+bh){enterFreeRoad(i);return;}
      }
    }
    return;
  }
  if(G.mode==='arrived'){
    if(G.arrivedT>0.8){G.mode='menu';G.menuFrom=null;G.menuTo=null;}
    return;
  }

  var vx=W-270,vy=20,vw=250,vh=34;
  if(m.x>=vx&&m.x<=vx+vw&&m.y>=vy&&m.y<=vy+vh){
    var vi=Math.floor((m.x-vx-5)/((vw-10)/4));
    if(vi>=0&&vi<VIEW_MODES.length){G.viewIdx=vi;return;}
  }

  if(e.button!==undefined&&e.button!==0) return;
  dragging=true;
  try{cv.setPointerCapture(e.pointerId);}catch(err){}
  var lat=screenToLat(e.clientX);
  G.targetLat=lat;
  G.lateralVel=(G.targetLat-G.playerLat)*2.5;
  G.autoDrive=false;
});
cv.addEventListener('pointermove',function(e){
  var m=getMouse(e);
  if(G.mode==='menu'){
    menuHover=cityAtPoint(m.x,m.y);
    modeHover=modeButtonAt(m.x,m.y);
    timeHover=timeButtonAt(m.x,m.y);
    return;
  }
  if(G.mode==='free-choose'){
    G.freeHoverIndex=-1;
    var opts=G.freeOptions||[];
    var cols=Math.min(3,opts.length);
    var bw=240,bh=74;
    var totalW=cols*bw+(cols-1)*16;
    var startX=(W-totalW)/2;
    var startY=H*0.13+112;
    for(var i=0;i<opts.length;i++){
      var col=i%cols,row=Math.floor(i/cols);
      var bx=startX+col*(bw+16);
      var by=startY+row*(bh+14);
      if(m.x>=bx&&m.x<=bx+bw&&m.y>=by&&m.y<=by+bh){G.freeHoverIndex=i;break;}
    }
    return;
  }
  if(!dragging||G.mode!=='playing') return;
  var lat=screenToLat(e.clientX);
  G.targetLat=lat;
  G.lateralVel=(G.targetLat-G.playerLat)*3.5;
  G.autoDrive=false;
});
cv.addEventListener('pointerup',function(e){
  dragging=false;
  try{if(cv.hasPointerCapture(e.pointerId)) cv.releasePointerCapture(e.pointerId);}catch(err){}
});
cv.addEventListener('pointercancel',function(){dragging=false;});

// ═══════════════════════════════════════════════════════════════
//  主循环
// ═══════════════════════════════════════════════════════════════
var lastT=0;
function loop(t){
  requestAnimationFrame(loop);
  if(!lastT) lastT=t;
  var dt=(t-lastT)/1000;
  lastT=t;
  if(dt>0.05) dt=0.05;
  if(dt<=0) dt=0.0001;
  update(dt);
  render();
}
requestAnimationFrame(loop);

})();
</script>
