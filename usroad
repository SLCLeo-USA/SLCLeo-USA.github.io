function generateSkyline(city){
  var rng=mulberry32(hashStr(city.id));
  var P=THEME_PARAMS[city.theme]||THEME_PARAMS.metro;
  var out=[];
  var n=P.count[0]+Math.floor(rng()*(P.count[1]-P.count[0]));
  for(var i=0;i<n;i++){
    var side=rng()<0.5?-1:1;
    out.push({lat:side*(24+rng()*P.spread),relZ:-110+rng()*300,h:P.hMin+rng()*(P.hMax-P.hMin),w:P.wMin+rng()*(P.wMax-P.wMin),col:P.colors[(rng()*P.colors.length)|0],style:P.style,seed:rng()});
  }
  var lm=LANDMARKS[city.theme];
  if(lm) out.push(lm());
  if(P.trees){
    for(var t=0;t<14;t++){
      var s2=rng()<0.5?-1:1;
      out.push({lat:s2*(20+rng()*32),relZ:-90+rng()*280,h:11+rng()*11,w:6+rng()*4,col:'#3d5a3a',style:'tree',seed:rng()});
    }
  }
  return out;
}

