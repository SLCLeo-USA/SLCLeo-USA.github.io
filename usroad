var keys={};
var dragging=false;
var SPEED_MAX=62;
var SPEED_MAX_MAP={casual:58,real:48,free:58};

function update(dt){
  G.time+=dt;
  G.shake=Math.max(0,G.shake-dt*4);
  G.hitFlash=Math.max(0,G.hitFlash-dt*2.6);
  G.collisionCooldown=Math.max(0,G.collisionCooldown-dt);
  G.hazardTimer=Math.max(0,G.hazardTimer-dt);
  G.bumpY=Math.max(0,G.bumpY-dt*4);
  G.fadeAlpha=Math.max(0,G.fadeAlpha-dt*1.5);
  G.blinkers=Math.max(0,G.blinkers-dt);
  if(G.blinkers<=0) G.blinkSide=0;

  for(var i=0;i<G.clouds.length;i++){
    var c=G.clouds[i];c.x+=c.spd*dt;
    if(c.x>W+c.w){c.x=-c.w;c.y=rand(15,HORIZON_Y-70);}
  }
  for(var j=0;j<G.birds.length;j++){
    var b=G.birds[j];b.x+=b.spd*dt;b.ph+=dt*6;
    if(b.x>W+40){b.x=-40;b.y=rand(60,HORIZON_Y-40);}
  }
  if(G.mode==='arrived'||G.mode==='free-choose'){G.arrivedT+=dt;return;}
  if(G.mode!=='playing'||!G.route) return;

  updateDriving(dt);
  checkCollisions(dt);
  checkExitZones(dt);
  spawnScenery();
  spawnTraffic(dt);
  checkStopped(dt);
  recordTrack();

  if(G.camZ>=G.route.totalWorld){
    G.camZ=G.route.totalWorld;
    if(G.driveMode==='free') arriveFree();
    else {G.mode='arrived';G.arrivedT=0;G.speed=0;}
  }
  if(G.notif){G.notif.t-=dt;if(G.notif.t<=0) G.notif=null;}
}

function updateDriving(dt){
  SPEED_MAX=SPEED_MAX_MAP[G.driveMode]||58;
  var throttle=0,brake=0,steer=0;
  if(keys['q']||keys['Q']||keys['ArrowUp']) throttle=1;
  if(keys['a']||keys['A']||keys['ArrowDown']) brake=1;
  if(keys['ArrowLeft']) steer-=1;
  if(keys['ArrowRight']) steer+=1;
  G.throttle=throttle;
  G.brake=brake;

  if(G.autoDrive){
    autoDriveControl(dt);
  } else {
    if(throttle>0){
      var accel=SPEED_MAX*(1-G.speed/SPEED_MAX*0.55)*0.35;
      G.speed+=accel*dt;
    } else if(brake>0){
      var decel=8+G.speed*0.12;
      G.speed-=decel*dt;
      if(G.speed<0) G.speed=0;
    } else {
      G.speed-=G.speed*0.15*dt;
      if(G.speed<0.3) G.speed=0;
    }
  }

  var absLat=Math.abs(G.playerLat);
  if(absLat>ROAD_HW+SHOULDER){
    var off=absLat-ROAD_HW-SHOULDER;
    var drag=Math.min(2.4,off*0.30);
    G.speed-=G.speed*drag*dt;
    if(G.speed<0) G.speed=0;
    G.offRoadTime+=dt;
    G.bumpY=Math.max(G.bumpY,Math.min(1,off*0.12))*Math.max(0.7,G.speed*0.025);
    if(!G.offRoadWarned&&G.offRoadTime>0.35){G.offRoadWarned=true;G.notif={text:'⚠ 驶出公路',t:1.6};}
  } else {
    G.offRoadTime=0;G.offRoadWarned=false;
  }
  G.speed=clamp(G.speed,0,SPEED_MAX);

  if(!G.autoDrive){
    G.steerInput=steer;
    G.steerSmooth += (G.steerInput-G.steerSmooth)*Math.min(1,dt*6);
    var speedRatio=G.speed/SPEED_MAX;
    var maxLatAccel=9.0*(1-speedRatio*0.55);
    G.lateralVel += G.steerSmooth*maxLatAccel*dt;
    G.lateralVel *= Math.pow(0.06,dt);
    G.lateralVel=clamp(G.lateralVel,-8,8);
  }

  G.playerLat += G.lateralVel*dt;

  var laneGuess=1;
  if(G.playerLat<4.3) laneGuess=0;
  else if(G.playerLat<7.7) laneGuess=1;
  else laneGuess=2;
  G.playerLane=laneGuess;

  G.playerLat=clamp(G.playerLat,-WALL_LAT,WALL_LAT);
  G.camLat+=(G.playerLat-G.camLat)*Math.min(1,dt*4.2);

  G.camZ+=G.speed*dt;
  G.totalMilesDriven+=G.speed*dt/(WORLD_PER_MILE[G.driveMode]||5.5);

  var cons=0.6+G.speed*0.05;
  G.fuel-=cons*dt*0.22;
  if(G.fuel<0) G.fuel=0;

  if(!G.autoDrive && Math.abs(G.steerSmooth)>0.15 && G.speed>4){
    if(G.steerSmooth>0){ if(G.blinkSide!==1){G.blinkSide=1;G.blinkers=2.5;} }
    else { if(G.blinkSide!==-1){G.blinkSide=-1;G.blinkers=2.5;} }
  }
}

function autoDriveControl(dt){
  var pz=G.camZ+PLAYER_Z;
  var lane=G.playerLane;
  var laneLat=LANE_R[lane];
  var desiredSpeed=SPEED_MAX*0.82;
  var safeDist=G.speed*1.5+15;
  var lead=null,leadD=250;
  for(var i=0;i<G.traffic.length;i++){
    var t=G.traffic[i];
    if(t.oncoming) continue;
    if(Math.abs(t.lat-laneLat)>2.0) continue;
    var d=t.z-pz;
    if(d>0&&d<leadD){leadD=d;lead=t;}
  }
  if(lead&&leadD<safeDist*1.6){
    var wantLane=lane===2?1:(lane===0?1:2);
    var wantLat=LANE_R[wantLane];
    var laneSafe=true;
    for(var j=0;j<G.traffic.length;j++){
      var o=G.traffic[j];
      if(o.oncoming) continue;
      if(Math.abs(o.lat-wantLat)>2.2) continue;
      var dz=o.z-pz;
      if(dz>-20&&dz<60){laneSafe=false;break;}
    }
    if(laneSafe&&leadD<safeDist){
      G.playerLane=wantLane;
      var targetVel=(wantLat-G.playerLat)*1.5;
      G.lateralVel += (targetVel-G.lateralVel)*Math.min(1,dt*3);
      lane=wantLane;laneLat=wantLat;
    } else {
      var followSpeed=lead.spd*0.92+Math.max(0,(leadD-safeDist*0.5))*0.35;
      desiredSpeed=Math.min(desiredSpeed,followSpeed);
    }
  } else {
    if(G.playerLane!==2&&Math.random()<dt*0.4){
      var rightLat=LANE_R[2];
      var rightSafe=true;
      for(var k=0;k<G.traffic.length;k++){
        var o2=G.traffic[k];
        if(o2.oncoming) continue;
        if(Math.abs(o2.lat-rightLat)>2.2) continue;
        var dz2=o2.z-pz;
        if(dz2>-20&&dz2<60){rightSafe=false;break;}
      }
      if(rightSafe){
        G.playerLane=2;
        var tVel=(rightLat-G.playerLat)*1.5;
        G.lateralVel += (tVel-G.lateralVel)*Math.min(1,dt*3);
      }
    }
  }
  var diff=desiredSpeed-G.speed;
  if(diff>1.2){G.throttle=clamp(diff/14,0.3,1);G.brake=0;G.speed+=diff*Math.min(1,dt*0.55);}
  else if(diff<-1.5){G.throttle=0;G.brake=clamp(-diff/10,0.2,1);G.speed+=diff*Math.min(1,dt*0.85);}
  else {G.throttle=0.4;G.brake=0;G.speed+=diff*Math.min(1,dt*0.4);}
}

function checkCollisions(dt){
  if(G.collisionCooldown>0) return;
  var pz=G.camZ+PLAYER_Z,pl=G.playerLat;
  for(var i=0;i<G.traffic.length;i++){
    var t=G.traffic[i];
    var dz=t.z-pz,dl=t.lat-pl;
    var carHalfLen=t.kind==='truck'?2.6:1.7;
    var carHalfWid=t.kind==='truck'?1.15:0.95;
    if(Math.abs(dz)<carHalfLen+1.2&&Math.abs(dl)<carHalfWid+0.85){
      doCollision(t,dz,dl);return;
    }
  }
}
function doCollision(t,dz,dl){
  G.collisionCooldown=0.7;
  G.shake=1.3;G.hitFlash=0.6;G.hazardTimer=4.5;
  var impact=G.speed;
  if(Math.abs(dz)<1.0&&impact>25){G.speed=0;G.stoppedTimer=0;G.notif={text:'⚠ 严重碰撞',t:2.0};}
  else if(impact>15){G.speed*=0.25;G.notif={text:'⚠ 发生碰撞',t:1.5};}
  else {G.speed*=0.5;G.notif={text:'擦碰',t:1.2};}
  var push=dl>0?-1:1;
  G.lateralVel=push*3.0;
  G.camLat+=push*0.5;
  t.lat-=push*1.6;t.z+=dz>0?3.5:-3.5;
}
function checkStopped(dt){
  if(G.speed<1.5){G.stoppedTimer+=dt;} else G.stoppedTimer=0;
}

function checkExitZones(dt){
  G.activeExit=null;
  G.refueling=false;
  var pz=G.camZ+PLAYER_Z;
  for(var i=0;i<G.exitZones.length;i++){
    var zone=G.exitZones[i];
    if(zone.exited) continue;
    var dist=zone.zStart-pz;
    var endDist=zone.zEnd-pz;

    if(dist<0 && endDist>-8){
      if(zone.type==='city'){
        if(G.playerLat>8.2&&G.speed>3){
          zone.exited=true;
          takeCityRamp(zone);
          return;
        }
      } else if(zone.type==='service'){
        if(G.playerLat>ROAD_HW+SHOULDER-1.5 && G.speed<28){
          if(zone.kind==='gas' && G.fuel<100){
            G.fuel=Math.min(100,G.fuel+22*dt);
            G.refueling=true;
          }
        }
      }
    }
    if(dist>-200 && dist<0){
      if(zone.type==='city' && !zone.exited){
        G.activeExit=zone;
      }
    }
  }
}

// ═══ 修复后的匝道逻辑：从当前城市出发，而非路段起点 ═══
function takeCityRamp(zone){
  // 玩家当前在城市 zone.city（路段终点城市）
  var curCity=zone.city;
  if(!curCity) return;
  var opts=zone.opts||[];
  if(!opts.length) return;

  // 选择一条从当前城市出发的公路
  var pick=opts[0];
  if(G.driveMode==='free'&&opts.length>1) pick=opts[randi(opts.length)];
  var toCity=CITY_MAP[pick.to];
  if(!toCity) return;

  var edge={to:pick.to,name:pick.name,miles:pick.miles};
  var route=buildFreeRoute(curCity,edge,toCity);
  var signs=[{z:route.totalWorld*0.42,lat:14,city:toCity,distMi:edge.miles}];

  G.fadeAlpha=0.9;
  G.route=route;G.camZ=0;
  G.speed=Math.max(8,G.speed*0.55);
  G.playerLane=1;
  G.playerLat=LANE_R[1];G.targetLat=LANE_R[1];G.camLat=LANE_R[1];
  G.lateralVel=0;
  G.signs=signs;
  G.traffic=[];G.sceneries=[];
  G.nextTraffic=90;G.nextScen=25;
  G.notif={text:'进入 '+edge.name+' · 前往 '+toCity.name,t:2.8};
  G.exitZones=generateExitZones();
  G.trackPoints=[];
  G.activeExit=null;
}

function spawnScenery(){
  var ahead=G.camZ+420;
  while(G.nextScen<ahead){
    var z=G.nextScen;
    var side=Math.random()<0.5?-1:1;
    G.sceneries.push({z:z,lat:side*rand(14,100),size:rand(0.65,2.2),kind:'auto',seed:Math.random()});
    G.nextScen=z+rand(10,26);
  }
  if(G.sceneries.length>340) G.sceneries=G.sceneries.filter(function(o){return o.z-G.camZ>-25;});
}
function spawnTraffic(dt){
  var ahead=G.camZ+360;
  while(G.nextTraffic<ahead){
    var z=G.nextTraffic;
    var laneSet=Math.random()<0.5?LANE_L:LANE_R;
    var lane=laneSet[randi(3)];
    var oncoming=lane<0;
    var isTruck=Math.random()<0.28;
    var spd;
    if(oncoming) spd=isTruck?rand(38,48):rand(46,60);
    else spd=isTruck?rand(30,38):rand(36,50);
    G.traffic.push({
      z:z,lat:lane+rand(-0.45,0.45),spd:spd,oncoming:oncoming,
      color:['#c0392b','#2c6fa8','#dddddd','#3a3a3a','#b8860b','#4a7a5a','#8a4a8a','#d45a2a','#e8e8e8','#1f3a5c','#e8e0d0','#2a2a2a'][randi(12)],
      kind:isTruck?'truck':'car',blink:Math.random()*6
    });
    G.nextTraffic=z+rand(45,110);
  }
  for(var i=0;i<G.traffic.length;i++){
    var t=G.traffic[i];
    t.z+=(t.oncoming?-t.spd:t.spd-42)*dt;
    t.blink+=dt*3;
  }
  G.traffic=G.traffic.filter(function(t){var rz=t.z-G.camZ;return rz>-30&&rz<380;});
}
function recordTrack(){
  var lastT=G.trackPoints[G.trackPoints.length-1];
  if(!lastT || Math.abs(G.camZ-lastT.z)>15){
    var seg=segAtWorld(G.route,G.camZ);
    if(!seg) return;
    G.trackPoints.push({z:G.camZ,lat:G.playerLat,x:G.camLat,seg:seg.name});
    if(G.trackPoints.length>800) G.trackPoints.shift();
  }
}

function arriveFree(){
  G.mode='free-choose';G.arrivedT=0;G.speed=0;
  var curId=G.route.segments[0].to;
  var curCity=CITY_MAP[curId];
  G.freeCity=curCity;
  var nbrs=GRAPH[curId]||[];
  var opts=[];
  for(var i=0;i<nbrs.length;i++){
    var n=nbrs[i];
    var dest=CITY_MAP[n.to];
    if(!dest) continue;
    opts.push({id:n.to,name:dest.name,highway:n.name,miles:n.miles,state:dest.state});
  }
  G.freeOptions=opts;G.freeHoverIndex=-1;
}

// ═══════════════════════════════════════════════════════════════
//  渲染
// ═══════════════════════════════════════════════════════════════
function render(){
  var sky=skyState();
  var land=currentLandscape();
  var view=VIEW_MODES[G.viewIdx];

  ctx.save();

  // 相机偏移（追尾/航拍）
  var camOffX=0,camOffY=0;
  if(view.id==='chase'){
    camOffX=0;
    camOffY=-6;
  } else if(view.id==='top'){
    camOffX=0;
    camOffY=-30;
  }

  var sx=camOffX,sy=camOffY;
  if(G.shake>0.01){
    sx+=(Math.random()-0.5)*G.shake*10;
    sy+=(Math.random()-0.5)*G.shake*10;
  }
  if(G.bumpY>0.05){
    sy+=Math.sin(G.time*45)*G.bumpY*4;
    sx+=Math.sin(G.time*31)*G.bumpY*2;
  }
  if(G.speed>SPEED_MAX*0.6){
    var hiVib=Math.min(0.5,(G.speed-SPEED_MAX*0.6)/SPEED_MAX);
    sy+=Math.sin(G.time*62)*hiVib*0.7;
  }
  ctx.translate(sx,sy);

  // 根据视角缩放
  if(view.id==='top'){
    ctx.translate(W/2,H/2);
    ctx.scale(0.82,0.82);
    ctx.translate(-W/2,-H/2);
  }

  drawSky(sky);
  drawClouds(sky);
  drawBirds(sky);
  drawLandscape(sky,land);
  if(G.route) drawCities(sky);
  drawRoad(sky);
  if(G.route) drawExitZonesVisual(sky);
  drawScenery(sky);
  drawTraffic(sky);
  if(G.route) drawSigns(sky);
  if(view.id==='chase') drawPlayerCar();
  ctx.restore();

  if(G.offRoadTime>0.25&&G.mode==='playing'){
    var a=Math.min(0.20,G.offRoadTime*0.35);
    var vg=ctx.createRadialGradient(W/2,H/2,H*0.3,W/2,H/2,H*0.95);
    vg.addColorStop(0,'rgba(120,90,50,0)');
    vg.addColorStop(1,'rgba(120,90,50,'+a+')');
    ctx.fillStyle=vg;ctx.fillRect(0,0,W,H);
  }
  if(G.hitFlash>0){
    ctx.fillStyle='rgba(255,60,50,'+(G.hitFlash*0.28)+')';
    ctx.fillRect(0,0,W,H);
  }

  if(view.hoodH>0.05) drawHoodOrCockpit();

  if(G.fadeAlpha>0.01){
    ctx.fillStyle='rgba(6,10,20,'+G.fadeAlpha+')';
    ctx.fillRect(0,0,W,H);
  }

  if(G.mode==='playing'||G.mode==='free-choose') drawHUD();
  if(G.mode==='menu') drawMenu();
  if(G.mode==='arrived') drawArrived();
  if(G.mode==='free-choose') drawFreeChoose();
}

// ── 玩家车体（追尾视角显示）──
function drawPlayerCar(){
  var s=FOCAL/(PLAYER_Z+3);
  var x=W/2+(roadOffset(PLAYER_Z+3)+G.playerLat-G.camLat)*s;
  var y=HORIZON_Y+CAM_H*s+40;
  var cw=2.5*s,ch=1.5*s;
  if(cw<10) return;

  ctx.save();
  // 车影
  ctx.fillStyle='rgba(0,0,0,0.42)';
  ctx.beginPath();
  ctx.ellipse(x,y+4,cw*0.62,s*0.34,0,0,7);
  ctx.fill();

  // 车顶
  ctx.fillStyle='#7a2828';
  roundRect(x-cw*0.36,y-ch*1.55,cw*0.72,ch*0.78,s*0.18);ctx.fill();
  // 后窗
  ctx.fillStyle='#2e3b4c';
  roundRect(x-cw*0.31,y-ch*1.47,cw*0.62,ch*0.54,s*0.12);ctx.fill();
  ctx.fillStyle='rgba(150,205,240,0.30)';
  roundRect(x-cw*0.27,y-ch*1.43,cw*0.52,ch*0.24,s*0.1);ctx.fill();
  // 车身
  var bg=ctx.createLinearGradient(0,y-ch,0,y);
  bg.addColorStop(0,'#dc4d4d');bg.addColorStop(0.5,'#c23b3b');bg.addColorStop(1,'#8f2828');
  ctx.fillStyle=bg;
  roundRect(x-cw/2,y-ch,cw,ch,s*0.26);ctx.fill();
  // 高光
  ctx.fillStyle='rgba(255,255,255,0.18)';
  roundRect(x-cw*0.44,y-ch*0.97,cw*0.88,ch*0.2,s*0.1);ctx.fill();
  // 尾灯
  ctx.fillStyle='rgba(255,70,70,0.85)';
  roundRect(x-cw*0.47,y-ch*0.66,cw*0.19,ch*0.3,s*0.08);ctx.fill();
  roundRect(x+cw*0.28,y-ch*0.66,cw*0.19,ch*0.3,s*0.08);ctx.fill();
  // 车牌
  ctx.fillStyle='#e8dfc8';
  roundRect(x-cw*0.15,y-ch*0.48,cw*0.3,ch*0.2,s*0.05);ctx.fill();
  // 轮胎
  ctx.fillStyle='#15151a';
  roundRect(x-cw*0.56,y-ch*0.42,cw*0.17,ch*0.46,s*0.07);ctx.fill();
  roundRect(x+cw*0.39,y-ch*0.42,cw*0.17,ch*0.46,s*0.07);ctx.fill();
  ctx.restore();
}

function drawSky(sky){
  var g=ctx.createLinearGradient(0,-40,0,HORIZON_Y+60);
  g.addColorStop(0,rgb(sky.top));g.addColorStop(1,rgb(sky.bot));
  ctx.fillStyle=g;ctx.fillRect(-60,-60,W+120,H+120);
  if(sky.night>0.05){
    var rng=mulberry32(12345);
    ctx.globalAlpha=sky.night*0.85;
    for(var i=0;i<100;i++){
      var sx=rng()*W,sy=rng()*(HORIZON_Y-30);
      var tw=0.55+0.45*Math.sin(G.time*2.2+i);
      ctx.fillStyle='rgba(255,255,255,'+tw+')';
      ctx.fillRect(sx,sy,1.5,1.5);
    }
    ctx.globalAlpha=1;
  }
  var sunR=34;
  var glow=ctx.createRadialGradient(sky.sunX,sky.sunY,0,sky.sunX,sky.sunY,sunR*5.5);
  glow.addColorStop(0,rgba(sky.sunColor,0.50));
  glow.addColorStop(0.20,rgba(sky.sunColor,0.20));
  glow.addColorStop(1,rgba(sky.sunColor,0));
  ctx.fillStyle=glow;ctx.beginPath();ctx.arc(sky.sunX,sky.sunY,sunR*5.5,0,7);ctx.fill();
  ctx.fillStyle=rgba(sky.sunColor,0.95);
  ctx.beginPath();ctx.arc(sky.sunX,sky.sunY,sunR,0,7);ctx.fill();
}
function drawClouds(sky){
  var tint=lerpC3(sky.bot,sky.top,0.35);
  for(var i=0;i<G.clouds.length;i++){
    var c=G.clouds[i];
    ctx.globalAlpha=c.a*(0.5+sky.night*0.5);
    ctx.fillStyle=rgb(tint);
    ctx.beginPath();
    ctx.ellipse(c.x,c.y,c.w*0.5,c.h*0.5,0,0,7);
    ctx.ellipse(c.x-c.w*0.26,c.y+c.h*0.12,c.w*0.34,c.h*0.42,0,0,7);
    ctx.ellipse(c.x+c.w*0.28,c.y+c.h*0.1,c.w*0.32,c.h*0.4,0,0,7);
    ctx.ellipse(c.x+c.w*0.05,c.y-c.h*0.22,c.w*0.3,c.h*0.4,0,0,7);
    ctx.fill();
  }
  ctx.globalAlpha=1;
}
function drawBirds(sky){
  if(sky.night>0.5) return;
  ctx.strokeStyle='rgba(30,30,40,0.45)';ctx.lineWidth=1.6;
  for(var i=0;i<G.birds.length;i++){
    var b=G.birds[i];var f=Math.sin(b.ph)*4;
    ctx.beginPath();
    ctx.moveTo(b.x-6,b.y+f);ctx.lineTo(b.x,b.y-1);ctx.lineTo(b.x+6,b.y+f);
    ctx.stroke();
  }
}
function drawLandscape(sky,land){
  var baseY=HORIZON_Y+3;
  var p=G.route?clamp(G.camZ/G.route.totalWorld,0,1):0;
  var nightAmt=sky.night;
  var tint=lerpC3(sky.bot,sky.top,0.55);
  var nearC=lerpC3(land.ground,tint,0.25);
  var gd=ctx.createLinearGradient(0,HORIZON_Y,0,H);
  gd.addColorStop(0,rgb(nearC));
  gd.addColorStop(1,rgb([nearC[0]*0.72,nearC[1]*0.75,nearC[2]*0.68]));
  ctx.fillStyle=gd;
  ctx.fillRect(-60,HORIZON_Y,W+120,H-HORIZON_Y+100);
  drawMountainLayer(land.far,land.h*0.85,p,0.0042,0.55,nightAmt,false);
  drawMountainLayer(land.mid,land.h*1.10,p,0.0072,0.95,nightAmt,land.snow);
  drawMountainLayer(land.near,land.h*0.72,p,0.0118,1.4,nightAmt,false);
  if(land.canyon) drawCanyon(sky);
}
function drawMountainLayer(color,hMul,p,freq,ampMul,nightAmt,showSnow){
  var baseY=HORIZON_Y+3;
  var col=[color[0],color[1],color[2]];
  if(nightAmt>0) col=[col[0]*(1-nightAmt*0.5),col[1]*(1-nightAmt*0.5),col[2]*(1-nightAmt*0.55)];
  ctx.fillStyle=rgb(col);
  ctx.beginPath();
  ctx.moveTo(-30,baseY);
  for(var x=-30;x<=W+30;x+=8){
    var wx=(x+G.camLat*25)*freq;
    var y=baseY-((Math.sin(wx*0.9+2.1)*0.5+0.5)*0.7+Math.sin(wx*2.3+0.4)*0.2+Math.sin(wx*0.4+1.1)*0.35)*(48+p*30)*hMul*ampMul;
    ctx.lineTo(x,y);
  }
  ctx.lineTo(W+30,baseY+100);ctx.lineTo(-30,baseY+100);ctx.closePath();ctx.fill();
  if(showSnow&&hMul>0.9){
    var rng=mulberry32(777);
    ctx.fillStyle='rgba(245,248,255,0.55)';
    for(var i=0;i<40;i++){
      var px=rng()*W;
      var wx2=(px+G.camLat*25)*freq;
      var peakY=baseY-((Math.sin(wx2*0.9+2.1)*0.5+0.5)*0.7+Math.sin(wx2*2.3+0.4)*0.2+Math.sin(wx2*0.4+1.1)*0.35)*(48+p*30)*hMul*ampMul;
      var snowH=6+rng()*10;
      ctx.beginPath();
      ctx.moveTo(px-6,peakY+snowH);ctx.lineTo(px,peakY);ctx.lineTo(px+6,peakY+snowH);
      ctx.closePath();ctx.fill();
    }
  }
}
function drawCanyon(sky){
  var baseY=HORIZON_Y+22;
  var nightAmt=sky.night;
  ctx.fillStyle=rgba([190,120,85],0.55-nightAmt*0.3);
  ctx.beginPath();
  ctx.moveTo(-30,baseY);
  for(var x=-30;x<=W*0.35;x+=8){
    var wx=(x+G.camLat*22)*0.008;
    var y=baseY-(Math.sin(wx*1.7+0.4)*0.5+0.5)*44;
    ctx.lineTo(x,y);
  }
  ctx.lineTo(W*0.35,baseY+80);ctx.lineTo(-30,baseY+80);ctx.closePath();ctx.fill();
  ctx.fillStyle=rgba([170,105,72],0.55-nightAmt*0.3);
  ctx.beginPath();
  ctx.moveTo(W+30,baseY);
  for(var x2=W+30;x2>=W*0.65;x2-=8){
    var wx2=(x2+G.camLat*22)*0.008;
    var y2=baseY-(Math.sin(wx2*1.7+1.9)*0.5+0.5)*44;
    ctx.lineTo(x2,y2);
  }
  ctx.lineTo(W*0.65,baseY+80);ctx.lineTo(W+30,baseY+80);ctx.closePath();ctx.fill();
  var grad=ctx.createLinearGradient(0,baseY,0,baseY+70);
  grad.addColorStop(0,'rgba(40,25,18,0)');
  grad.addColorStop(1,'rgba(40,25,18,0.6)');
  ctx.fillStyle=grad;ctx.fillRect(W*0.28,baseY,W*0.44,70);
}

function drawCities(sky){
  if(!G.route) return;
  var wps=routeWaypoints();
  for(var w=0;w<wps.length;w++){
    var wp=wps[w];
    var cityRz=wp.worldZ-G.camZ;
    if(cityRz>1400||cityRz<-240) continue;
    var city=wp.city;
    if(!city._blds) city._blds=generateSkyline(city);
    var blds=city._blds;
    var fade=clamp((1400-cityRz)/380,0,1)*clamp((cityRz+240)/150,0,1);
    if(fade<=0.01) continue;
    ctx.globalAlpha=fade;
    var items=[];
    for(var i=0;i<blds.length;i++) items.push({b:blds[i],z:cityRz+blds[i].relZ});
    items.sort(function(a,c){return c.z-a.z;});
    for(var j=0;j<items.length;j++){
      var it=items[j],z=it.z;
      if(z<3.5||z>1350) continue;
      var s=FOCAL/z;
      var x=W/2+(roadOffset(z)+it.b.lat-G.camLat)*s;
      var y=HORIZON_Y+CAM_H*s;
      var bw=it.b.w*s,bh=it.b.h*s;
      if(bh<0.6||bw<0.4) continue;
      if(x-bw/2>W+180||x+bw/2<-180) continue;
      drawBuilding(it.b,x,y,bw,bh,s,z,sky);
    }
    ctx.globalAlpha=1;
  }
}
function routeWaypoints(){
  if(!G.route) return [];
  var out=[],segs=G.route.segments;
  for(var i=0;i<segs.length;i++){
    var seg=segs[i];
    out.push({city:CITY_MAP[seg.from],worldZ:seg.worldStart});
    if(i===segs.length-1) out.push({city:CITY_MAP[seg.to],worldZ:seg.worldEnd});
  }
  return out;
}
function drawBuilding(b,x,y,bw,bh,s,z,sky){
  var top=y-bh;
  var fogAmt=clamp((z-100)/560,0,0.78);
  var night=sky.night;
  if(b.style==='tree'){
    ctx.fillStyle=b.col;
    ctx.fillRect(x-bw*0.12,y-bh*0.4,bw*0.24,bh*0.4);
    ctx.beginPath();ctx.arc(x,top+bh*0.4,bw*0.62,0,7);ctx.fill();
    return;
  }
  if(b.style==='arch'){
    ctx.fillStyle=b.col;
    ctx.beginPath();
    ctx.moveTo(x-bw/2,y);ctx.lineTo(x-bw/2,top+bh*0.28);
    ctx.quadraticCurveTo(x,top-bh*0.06,x+bw/2,top+bh*0.28);
    ctx.lineTo(x+bw/2,y);ctx.lineTo(x+bw*0.32,y);
    ctx.lineTo(x+bw*0.32,top+bh*0.44);
    ctx.quadraticCurveTo(x,top+bh*0.22,x-bw*0.32,top+bh*0.44);
    ctx.lineTo(x-bw*0.32,y);ctx.closePath();ctx.fill();
    return;
  }
  if(b.style==='needle'){
    ctx.fillStyle=b.col;
    ctx.fillRect(x-bw/2,y-bh*0.72,bw,bh*0.72);
    ctx.beginPath();ctx.ellipse(x,y-bh*0.78,bw*2.2,bh*0.1,0,0,7);ctx.fill();
    ctx.fillRect(x-bw*0.3,top,bw*0.6,bh*0.3);
    ctx.beginPath();
    ctx.moveTo(x-bw*0.3,top+bh*0.02);ctx.lineTo(x,top-bh*0.13);ctx.lineTo(x+bw*0.3,top+bh*0.02);
    ctx.closePath();ctx.fill();
    return;
  }
  if(b.style==='obelisk'){
    ctx.fillStyle=b.col;
    ctx.beginPath();
    ctx.moveTo(x-bw/2,y);ctx.lineTo(x-bw*0.38,top);
    ctx.lineTo(x+bw*0.38,top);ctx.lineTo(x+bw/2,y);
    ctx.closePath();ctx.fill();
    return;
  }
  if(b.style==='bridge'){
    ctx.strokeStyle=b.col;ctx.lineWidth=Math.max(1.5,s*1.2);
    ctx.beginPath();
    ctx.moveTo(x-bw/2,y);
    ctx.quadraticCurveTo(x,y-bh*1.6,x+bw/2,y);
    ctx.stroke();
    ctx.fillStyle=b.col;
    ctx.fillRect(x-bw*0.35,y-bh*1.3,s*2,bh*1.3);
    ctx.fillRect(x+bw*0.35-s*2,y-bh*1.3,s*2,bh*1.3);
    ctx.strokeStyle=b.col;ctx.lineWidth=Math.max(0.6,s*0.4);
    for(var bi=0;bi<8;bi++){
      var bt=bi/7;
      var bx=x-bw/2+bt*bw;
      var by=y-(1-Math.abs(bt-0.5)*2)*(bh*1.4)-s*1.2;
      ctx.beginPath();
      ctx.moveTo(bx,by);ctx.lineTo(bx,y);
      ctx.stroke();
    }
    return;
  }
  if(s>0.6){
    ctx.fillStyle=shade(b.col,-0.16);
    ctx.fillRect(x-bw*0.53,y-bh*0.05,bw*1.06,bh*0.05);
  }
  ctx.fillStyle=b.col;
  ctx.fillRect(x-bw/2,top,bw,bh);
  if(s>0.85){
    var sg=ctx.createLinearGradient(x-bw/2,0,x+bw/2,0);
    sg.addColorStop(0,'rgba(255,255,255,0.07)');
    sg.addColorStop(0.55,'rgba(0,0,0,0)');
    sg.addColorStop(1,'rgba(0,0,0,0.20)');
    ctx.fillStyle=sg;ctx.fillRect(x-bw/2,top,bw,bh);
  }
  if(s>0.7){
    ctx.fillStyle=shade(b.col,0.13);
    ctx.fillRect(x-bw/2-s*0.2,top-s*0.32,bw+s*0.4,s*0.36);
  }
  if(b.style==='spire'){
    ctx.beginPath();
    ctx.moveTo(x-bw/2,top);ctx.lineTo(x,top-bh*0.3);ctx.lineTo(x+bw/2,top);
    ctx.closePath();ctx.fillStyle=b.col;ctx.fill();
  }
  if(b.style==='glass'&&s>1.0&&bw>6){
    ctx.fillStyle='rgba(170,210,240,0.10)';
    var stripes=Math.max(2,Math.floor(bw/(s*3.2)));
    for(var si=0;si<stripes;si++){
      var sx=x-bw/2+(si+0.5)*(bw/stripes);
      ctx.fillRect(sx-Math.max(0.4,s*0.12),top,Math.max(0.8,s*0.24),bh);
    }
  }
  if(s>1.0&&bw>5&&bh>12){
    ctx.fillStyle=night>0.15?'rgba(255,222,152,'+(0.30+night*0.42)+')':'rgba(255,255,255,0.085)';
    var cols=Math.max(2,Math.floor(bw/(s*2.0)));
    var rows=Math.max(2,Math.floor(bh/(s*2.8)));
    var cw=bw/cols,rh=bh/rows;
    var seedv=Math.floor(b.seed*1000);
    for(var r=1;r<rows;r++){
      for(var c=0;c<cols;c++){
        if((r*7+c*13+seedv)%3===0){
          ctx.fillRect(x-bw/2+c*cw+cw*0.2,top+r*rh+rh*0.2,cw*0.55,rh*0.44);
        }
      }
    }
  }
  if(b.style==='neon'){
    var cols2=['#ff3b6b','#3bffd6','#ffd23b','#b83bff'];
    var nc=cols2[Math.floor(b.seed*4)];
    ctx.globalAlpha*=0.78;
    ctx.fillStyle=nc;
    ctx.fillRect(x-bw/2,top+bh*0.14,bw,Math.max(1,s*0.7));
    ctx.fillRect(x-bw/2,top+bh*0.72,bw,Math.max(1,s*0.7));
    ctx.globalAlpha/=0.78;
  }
  if(s>1.4&&bh>24&&b.style!=='spire'){
    var seed2=Math.floor(b.seed*1000);
    if(seed2%3===0){
      ctx.fillStyle=shade(b.col,-0.28);
      ctx.fillRect(x+bw*0.08,top-s*1.6,s*1.15,s*1.25);
      ctx.fillRect(x+bw*0.02,top-s*0.42,s*1.95,s*0.42);
    }
  }
  if(fogAmt>0.02){
    ctx.fillStyle=rgba(sky.bot,fogAmt*0.88);
    ctx.fillRect(x-bw/2,top,bw,bh);
  }
}

function drawRoad(sky){
  var SEG=64;
  var zNear=1.8,zFar=440;
  var pts=[];
  for(var i=0;i<=SEG;i++){
    var rz=zNear*Math.pow(zFar/zNear,i/SEG);
    var s=FOCAL/rz;
    pts.push({
      rz:rz,s:s,
      y:HORIZON_Y+CAM_H*s,
      cx:W/2+(roadOffset(rz)-G.camLat)*s,
      hw:ROAD_HW*s,
      sh:SHOULDER*s
    });
  }
  var fogC=lerpC3(sky.bot,sky.top,0.35);

  for(var i0=SEG-1;i0>=0;i0--){
    var a0=pts[i0+1],b0=pts[i0];
    if(a0.rz>220) continue;
    var fog0=Math.min(1,a0.rz/220);
    var shoulderCol=lerpC3([68,66,60],fogC,fog0*0.94);
    ctx.fillStyle=rgb(shoulderCol);
    ctx.beginPath();
    ctx.moveTo(a0.cx+a0.hw,a0.y);ctx.lineTo(a0.cx+a0.hw+a0.sh,a0.y);
    ctx.lineTo(b0.cx+b0.hw+b0.sh,b0.y);ctx.lineTo(b0.cx+b0.hw,b0.y);
    ctx.closePath();ctx.fill();
    ctx.beginPath();
    ctx.moveTo(a0.cx-a0.hw,a0.y);ctx.lineTo(a0.cx-a0.hw-a0.sh,a0.y);
    ctx.lineTo(b0.cx-b0.hw-b0.sh,b0.y);ctx.lineTo(b0.cx-b0.hw,b0.y);
    ctx.closePath();ctx.fill();
  }

  for(var i3=SEG-1;i3>=0;i3--){
    var a3=pts[i3+1],b3=pts[i3];
    var fog=Math.min(1,a3.rz/220);
    var col=lerpC3([52,52,56],fogC,fog*0.94);
    ctx.fillStyle=rgb(col);
    ctx.beginPath();
    ctx.moveTo(a3.cx-a3.hw,a3.y);ctx.lineTo(a3.cx+a3.hw,a3.y);
    ctx.lineTo(b3.cx+b3.hw,b3.y);ctx.lineTo(b3.cx-b3.hw,b3.y);
    ctx.closePath();ctx.fill();
  }

  for(var i4=SEG-1;i4>=0;i4--){
    var a4=pts[i4+1],b4=pts[i4];
    var mh_a=MEDIAN_HW*a4.s,mh_b=MEDIAN_HW*b4.s;
    var fog4=Math.min(1,a4.rz/220);
    var mc=lerpC3([70,72,68],fogC,fog4*0.94);
    ctx.fillStyle=rgb(mc);
    ctx.beginPath();
    ctx.moveTo(a4.cx-mh_a,a4.y);ctx.lineTo(a4.cx+mh_a,a4.y);
    ctx.lineTo(b4.cx+mh_b,b4.y);ctx.lineTo(b4.cx-mh_b,b4.y);
    ctx.closePath();ctx.fill();
  }

  drawLaneMarkings();

  ctx.fillStyle='rgba(240,240,235,0.68)';
  for(var i5=SEG-1;i5>=0;i5--){
    var a5=pts[i5+1],b5=pts[i5];
    if(a5.rz>200) continue;
    var lw_a=0.30*a5.s,lw_b=0.30*b5.s;
    var off_a=(ROAD_HW-0.7)*a5.s,off_b=(ROAD_HW-0.7)*b5.s;
    ctx.beginPath();
    ctx.moveTo(a5.cx-off_a,a5.y);ctx.lineTo(a5.cx-off_a+lw_a,a5.y);
    ctx.lineTo(b5.cx-off_b+lw_b,b5.y);ctx.lineTo(b5.cx-off_b,b5.y);
    ctx.closePath();ctx.fill();
    ctx.beginPath();
    ctx.moveTo(a5.cx+off_a-lw_a,a5.y);ctx.lineTo(a5.cx+off_a,a5.y);
    ctx.lineTo(b5.cx+off_b,b5.y);ctx.lineTo(b5.cx+off_b-lw_b,b5.y);
    ctx.closePath();ctx.fill();
  }

  ctx.fillStyle='rgba(250,208,80,0.72)';
  for(var i6=SEG-1;i6>=0;i6--){
    var a6=pts[i6+1],b6=pts[i6];
    if(a6.rz>200) continue;
    var yw_a=0.24*a6.s,yw_b=0.24*b6.s;
    var yo_a=MEDIAN_HW*a6.s,yo_b=MEDIAN_HW*b6.s;
    ctx.beginPath();
    ctx.moveTo(a6.cx-yo_a-yw_a,a6.y);ctx.lineTo(a6.cx-yo_a,a6.y);
    ctx.lineTo(b6.cx-yo_b,b6.y);ctx.lineTo(b6.cx-yo_b-yw_b,b6.y);
    ctx.closePath();ctx.fill();
    ctx.beginPath();
    ctx.moveTo(a6.cx+yo_a,a6.y);ctx.lineTo(a6.cx+yo_a+yw_a,a6.y);
    ctx.lineTo(b6.cx+yo_b+yw_b,b6.y);ctx.lineTo(b6.cx+yo_b,b6.y);
    ctx.closePath();ctx.fill();
  }
  drawGuardrails(pts);
}

function drawLaneMarkings(){
  var dashGap=16,dashLen=7;
  var startWZ=Math.ceil((G.camZ+4)/dashGap)*dashGap;
  var laneBorders=[4.4,7.8];
  ctx.fillStyle='rgba(240,240,235,0.72)';
  for(var wz=startWZ;wz<G.camZ+240;wz+=dashGap){
    var rz1=wz-G.camZ;
    if(rz1<4) continue;
    var rz2=rz1+dashLen;
    var s1=FOCAL/rz1,s2=FOCAL/rz2;
    var y1=HORIZON_Y+CAM_H*s1,y2=HORIZON_Y+CAM_H*s2;
    var c1=W/2+(roadOffset(rz1)-G.camLat)*s1;
    var c2=W/2+(roadOffset(rz2)-G.camLat)*s2;
    var w1=0.20*s1,w2=0.20*s2;
    if(w1<0.32) continue;
    var fog=Math.min(1,rz1/220);
    var alpha=0.72*(1-fog*0.85);
    if(alpha<0.05) continue;
    ctx.globalAlpha=alpha;
    for(var lb=0;lb<laneBorders.length;lb++){
      var bo=laneBorders[lb];
      var o1=bo*s1,o2=bo*s2;
      ctx.beginPath();
      ctx.moveTo(c1+o1-w1,y1);ctx.lineTo(c1+o1+w1,y1);
      ctx.lineTo(c2+o2+w2,y2);ctx.lineTo(c2+o2-w2,y2);
      ctx.closePath();ctx.fill();
      ctx.beginPath();
      ctx.moveTo(c1-o1-w1,y1);ctx.lineTo(c1-o1+w1,y1);
      ctx.lineTo(c2-o2+w2,y2);ctx.lineTo(c2-o2-w2,y2);
      ctx.closePath();ctx.fill();
    }
  }
  ctx.globalAlpha=1;
}
function drawGuardrails(pts){
  ctx.fillStyle='rgba(160,168,175,0.62)';
  for(var i=2;i<pts.length-1;i+=3){
    var p=pts[i];
    if(p.rz>170||p.rz<4) continue;
    var gh=Math.max(1.2,p.s*0.55);
    var gw=Math.max(0.8,p.s*0.28);
    var alpha=clamp((170-p.rz)/130,0,1)*0.75;
    ctx.globalAlpha=alpha;
    ctx.fillRect(p.cx-p.hw-p.sh-gw*0.8,p.y-gh,gw,gh);
    ctx.fillRect(p.cx+p.hw+p.sh-gw*0.2,p.y-gh,gw,gh);
  }
  ctx.globalAlpha=1;
}

function drawExitZonesVisual(sky){
  var pz=G.camZ+PLAYER_Z;
  var fogC=lerpC3(sky.bot,sky.top,0.35);
  for(var i=0;i<G.exitZones.length;i++){
    var zone=G.exitZones[i];
    if(zone.exited) continue;
    var distStart=zone.zStart-pz;
    var distEnd=zone.zEnd-pz;
    if(distEnd<-30||distStart>500) continue;
    if(zone.type==='city') drawCityRamp(sky,zone,fogC,i);
    else if(zone.type==='service') drawServiceRamp(sky,zone,fogC);
  }
}

function drawCityRamp(sky,zone,fogC,zoneIndex){
  var N=18;
  var pts=[];
  for(var i=0;i<=N;i++){
    var t=i/N;
    var rz=zone.zStart-G.camZ+(zone.zEnd-zone.zStart)*t;
    if(rz<3) continue;
    var s=FOCAL/rz;
    var offT=t*t*0.9;
    var lat=ROAD_HW+SHOULDER+offT*8;
    pts.push({
      rz:rz,s:s,
      y:HORIZON_Y+CAM_H*s,
      cx:W/2+(roadOffset(rz)+lat-G.camLat)*s,
      hw:(2.4+offT*1.2)*s
    });
  }
  if(pts.length<2) return;

  for(var j=pts.length-1;j>=0;j--){
    var p=pts[j];
    var fog=Math.min(1,p.rz/220);
    var col=lerpC3([56,56,60],fogC,fog*0.9);
    ctx.fillStyle=rgb(col);
    ctx.beginPath();
    ctx.moveTo(p.cx-p.hw,p.y);
    ctx.lineTo(p.cx+p.hw,p.y);
    if(j>0){
      var pn=pts[j-1];
      ctx.lineTo(pn.cx+pn.hw,pn.y);
      ctx.lineTo(pn.cx-pn.hw,pn.y);
    }
    ctx.closePath();ctx.fill();
  }

  ctx.fillStyle='rgba(240,240,235,0.55)';
  for(var k=0;k<pts.length-1;k++){
    var pa=pts[k+1],pb=pts[k];
    var wa=0.16*pa.s,wb=0.16*pb.s;
    ctx.beginPath();
    ctx.moveTo(pa.cx-pa.hw,pa.y);ctx.lineTo(pa.cx-pa.hw+wa,pa.y);
    ctx.lineTo(pb.cx-pb.hw+wb,pb.y);ctx.lineTo(pb.cx-pb.hw,pb.y);
    ctx.closePath();ctx.fill();
    ctx.beginPath();
    ctx.moveTo(pa.cx+pa.hw-wa,pa.y);ctx.lineTo(pa.cx+pa.hw,pa.y);
    ctx.lineTo(pb.cx+pb.hw,pb.y);ctx.lineTo(pb.cx+pb.hw-wb,pb.y);
    ctx.closePath();ctx.fill();
  }

  for(var m=2;m<pts.length-2;m+=3){
    var pm=pts[m];
    if(pm.hw<1.5) continue;
    var alpha=clamp((pm.rz-10)/40,0,0.85);
    ctx.fillStyle='rgba(240,235,180,'+alpha+')';
    var aw=pm.hw*0.5,ah=pm.hw*0.95;
    ctx.beginPath();
    ctx.moveTo(pm.cx,pm.y-ah);
    ctx.lineTo(pm.cx-aw,pm.y);
    ctx.lineTo(pm.cx-aw*0.4,pm.y);
    ctx.lineTo(pm.cx-aw*0.4,pm.y+ah*0.7);
    ctx.lineTo(pm.cx+aw*0.4,pm.y+ah*0.7);
    ctx.lineTo(pm.cx+aw*0.4,pm.y);
    ctx.lineTo(pm.cx+aw,pm.y);
    ctx.closePath();ctx.fill();
  }

  // 显示匝道目的地（相邻城市），不是当前城市
  var lastP=pts[pts.length-1];
  var targetCity = (zone.opts && zone.opts.length) ? CITY_MAP[zone.opts[0].to] : null;
  if(lastP&&lastP.hw>1&&targetCity){
    ctx.globalAlpha=0.92;
    ctx.fillStyle='#0d5c34';
    var labelW=Math.max(76,lastP.hw*14),labelH=Math.max(20,lastP.hw*4.5);
    roundRect(lastP.cx-labelW/2,lastP.y-labelH-10,labelW,labelH,5);ctx.fill();
    ctx.strokeStyle='rgba(255,255,255,0.85)';ctx.lineWidth=1;
    roundRect(lastP.cx-labelW/2,lastP.y-labelH-10,labelW,labelH,5);ctx.stroke();
    ctx.fillStyle='#ffffff';
    ctx.font='bold '+Math.max(10,labelH*0.55)+'px system-ui,sans-serif';
    ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.fillText(targetCity.name,lastP.cx,lastP.y-labelH/2-10);
    ctx.globalAlpha=1;
  }
}

function drawServiceRamp(sky,zone,fogC){
  var N=12;
  var pts=[];
  for(var i=0;i<=N;i++){
    var t=i/N;
    var rz=zone.zStart-G.camZ+(zone.zEnd-zone.zStart)*t;
    if(rz<3) continue;
    var s=FOCAL/rz;
    var lat=ROAD_HW+SHOULDER+t*t*zone.lat*0.85;
    pts.push({
      rz:rz,s:s,
      y:HORIZON_Y+CAM_H*s,
      cx:W/2+(roadOffset(rz)+lat-G.camLat)*s,
      hw:2.2*s
    });
  }
  if(pts.length<2) return;

  for(var j=pts.length-1;j>=0;j--){
    var p=pts[j];
    var fog=Math.min(1,p.rz/220);
    var col=lerpC3([58,58,62],fogC,fog*0.9);
    ctx.fillStyle=rgb(col);
    ctx.beginPath();
    ctx.moveTo(p.cx-p.hw,p.y);ctx.lineTo(p.cx+p.hw,p.y);
    if(j>0){
      var pn=pts[j-1];
      ctx.lineTo(pn.cx+pn.hw,pn.y);ctx.lineTo(pn.cx-pn.hw,pn.y);
    }
    ctx.closePath();ctx.fill();
  }

  var lastP=pts[pts.length-1];
  if(!lastP) return;
  var sz=lastP.s;
  var bx=lastP.cx+sz*4, by=lastP.y;
  var cw=7.5*sz,ch=1.0*sz;

  ctx.fillStyle='rgba(60,60,60,0.35)';
  ctx.beginPath();
  ctx.ellipse(bx,by,cw*0.95,sz*0.55,0,0,7);ctx.fill();

  if(zone.kind==='gas'){
    ctx.fillStyle='#e8e8e0';
    roundRect(bx-cw/2,by-ch*4.3,cw,ch,sz*0.3);ctx.fill();
    ctx.fillStyle='#c8c8c0';
    ctx.fillRect(bx-cw*0.42,by-ch*3.4,cw*0.06,ch*3.4);
    ctx.fillRect(bx+cw*0.36,by-ch*3.4,cw*0.06,ch*3.4);
    ctx.fillStyle='#f2f0e8';
    roundRect(bx-cw*0.3,by-ch*1.6,cw*0.6,ch*1.6,sz*0.2);ctx.fill();
    var brandCol=zone.name==='Shell'?'#f0c020':zone.name==='Chevron'?'#2a5cb8':zone.name==='BP'?'#4a9a3a':'#d63a2a';
    ctx.fillStyle=brandCol;
    roundRect(bx-cw*0.52,by-ch*5.8,cw*1.04,ch*1.25,sz*0.24);ctx.fill();
    if(sz>1.8){
      ctx.fillStyle='#ffffff';ctx.textAlign='center';ctx.textBaseline='middle';
      ctx.font='bold '+Math.max(5,sz*0.8)+'px system-ui,sans-serif';
      ctx.fillText(zone.name,bx,by-ch*5.18);
    }
    ctx.fillStyle='#4a4a4a';
    ctx.fillRect(bx-cw*0.18,by-ch*0.9,cw*0.12,ch*0.9);
    ctx.fillRect(bx+cw*0.06,by-ch*0.9,cw*0.12,ch*0.9);
  } else {
    var rw=6.8*sz,rh=1.6*sz;
    ctx.fillStyle='#d8d4c8';
    roundRect(bx-rw/2,by-rh*3.2,rw,rh*3.2,sz*0.2);ctx.fill();
    ctx.fillStyle='#4a8a3a';
    roundRect(bx-rw/2,by-rh*3.7,rw,rh*0.55,sz*0.16);ctx.fill();
    if(sz>1.8){
      ctx.fillStyle='#ffffff';ctx.textAlign='center';
      ctx.font='bold '+Math.max(5,sz*0.7)+'px system-ui,sans-serif';
      ctx.fillText('服务区',bx,by-rh*2.2);
    }
  }
}

function drawScenery(sky){
  var land=currentLandscape();
  var list=[];
  for(var i=0;i<G.sceneries.length;i++){
    var o=G.sceneries[i];
    var rz=o.z-G.camZ;
    if(rz>5&&rz<420) list.push({o:o,rz:rz});
  }
  list.sort(function(a,b){return b.rz-a.rz;});
  for(var j=0;j<list.length;j++){
    var it=list[j],o2=it.o,rz2=it.rz;
    var s=FOCAL/rz2;
    var x=W/2+(roadOffset(rz2)+o2.lat-G.camLat)*s;
    var y=HORIZON_Y+CAM_H*s;
    ctx.globalAlpha=clamp((rz2-5)/12,0,1);
    var kind=o2.kind;
    if(kind==='auto'){
      var r=o2.seed;
      if(land.canyon) kind=r<0.4?'rock':(r<0.7?'bush':'rock');
      else if(land.h>0.8) kind=r<0.65?'tree':(r<0.85?'bush':'rock');
      else if(land.h<0.4) kind=r<0.3?'bush':(r<0.55?'rock':'grass');
      else {
        if(o2.lat<0&&Math.abs(o2.lat)<22) kind='pole';
        else if(r<0.35) kind='tree';
        else if(r<0.5) kind='bush';
        else if(r<0.62) kind='rock';
        else if(r<0.75) kind='fence';
        else if(r<0.88) kind='grass';
        else kind='pole';
      }
      o2.kind=kind;
    }
    var sz=s*o2.size;
    if(sz<0.3){ctx.globalAlpha=1;continue;}
    if(kind==='tree'){
      ctx.fillStyle='#4a3a2a';
      ctx.fillRect(x-sz*0.16,y-sz*1.34,sz*0.32,sz*1.34);
      ctx.fillStyle=land.tree||'#3f6b3c';
      ctx.beginPath();
      ctx.arc(x,y-sz*2.1,sz*1.1,0,7);
      ctx.arc(x-sz*0.7,y-sz*1.5,sz*0.85,0,7);
      ctx.arc(x+sz*0.7,y-sz*1.5,sz*0.85,0,7);
      ctx.fill();
    } else if(kind==='bush'){
      ctx.fillStyle=land.tree||'#436b40';
      ctx.beginPath();
      ctx.arc(x,y-sz*0.6,sz*0.78,0,7);
      ctx.arc(x-sz*0.6,y-sz*0.38,sz*0.58,0,7);
      ctx.arc(x+sz*0.6,y-sz*0.38,sz*0.58,0,7);
      ctx.fill();
    } else if(kind==='rock'){
      ctx.fillStyle=land.canyon?'#a87858':'#8a7a68';
      ctx.beginPath();
      ctx.moveTo(x-sz*1.0,y);ctx.lineTo(x-sz*0.42,y-sz*0.85);
      ctx.lineTo(x+sz*0.28,y-sz*1.05);ctx.lineTo(x+sz*1.0,y-sz*0.22);
      ctx.lineTo(x+sz*0.8,y);ctx.closePath();ctx.fill();
    } else if(kind==='fence'){
      ctx.fillStyle='#7a6248';
      for(var fi=0;fi<3;fi++) ctx.fillRect(x-sz*1.6+fi*sz*1.6,y-sz*1.4,sz*0.22,sz*1.4);
      ctx.fillRect(x-sz*1.7,y-sz*1.1,sz*3.4,sz*0.18);
      ctx.fillRect(x-sz*1.7,y-sz*0.6,sz*3.4,sz*0.18);
    } else if(kind==='grass'){
      ctx.strokeStyle=land.canyon?'#a88858':'#5a7a4a';
      ctx.lineWidth=Math.max(0.6,sz*0.12);
      for(var gi=-2;gi<=2;gi++){
        ctx.beginPath();
        ctx.moveTo(x+gi*sz*0.3,y);ctx.lineTo(x+gi*sz*0.4+sz*0.2,y-sz*0.9);
        ctx.stroke();
      }
    } else if(kind==='pole'){
      ctx.fillStyle='#4a4a4a';
      ctx.fillRect(x-sz*0.11,y-sz*7,sz*0.22,sz*7);
      ctx.fillRect(x-sz*0.7,y-sz*6.6,sz*1.4,sz*0.16);
      ctx.fillRect(x-sz*0.55,y-sz*6.0,sz*1.1,sz*0.14);
      ctx.strokeStyle='#3a3a3a';ctx.lineWidth=Math.max(0.5,sz*0.07);
      ctx.beginPath();
      ctx.moveTo(x-sz*0.7,y-sz*6.6);
      ctx.quadraticCurveTo(x,y-sz*6.0,x+sz*0.7,y-sz*6.6);
      ctx.stroke();
    }
    ctx.globalAlpha=1;
  }
}

function drawTraffic(sky){
  var list=[];
  for(var i=0;i<G.traffic.length;i++){
    var t=G.traffic[i];
    var rz=t.z-G.camZ;
    if(rz>3&&rz<400) list.push({t:t,rz:rz});
  }
  list.sort(function(a,b){return b.rz-a.rz;});
  for(var j=0;j<list.length;j++){
    var it=list[j],t2=it.t,rz2=it.rz;
    var s=FOCAL/rz2;
    var x=W/2+(roadOffset(rz2)+t2.lat-G.camLat)*s;
    var y=HORIZON_Y+CAM_H*s;
    ctx.globalAlpha=clamp((rz2-3)/13,0,1);
    var cw=(t2.kind==='truck'?3.1:2.25)*s;
    var ch=(t2.kind==='truck'?2.7:1.45)*s;
    ctx.fillStyle='rgba(0,0,0,0.32)';
    ctx.beginPath();ctx.ellipse(x,y,cw*0.6,s*0.32,0,0,7);ctx.fill();
    if(t2.oncoming){
      ctx.fillStyle=t2.color;
      roundRect(x-cw/2,y-ch,cw,ch,s*0.24);ctx.fill();
      ctx.fillStyle='rgba(18,24,34,0.78)';
      roundRect(x-cw*0.35,y-ch*0.82,cw*0.7,ch*0.5,s*0.12);ctx.fill();
      ctx.fillStyle='rgba(255,255,255,0.16)';
      roundRect(x-cw*0.38,y-ch*0.96,cw*0.76,ch*0.16,s*0.08);ctx.fill();
      ctx.fillStyle='rgba(255,248,215,0.95)';
      ctx.fillRect(x-cw*0.44,y-ch*0.5,cw*0.18,ch*0.18);
      ctx.fillRect(x+cw*0.26,y-ch*0.5,cw*0.18,ch*0.18);
      if(sky.night>0.2){
        var gl=ctx.createRadialGradient(x,y-ch*0.4,0,x,y-ch*0.4,cw*2.4);
        gl.addColorStop(0,'rgba(255,248,215,'+(0.28*sky.night)+')');
        gl.addColorStop(1,'rgba(255,248,215,0)');
        ctx.fillStyle=gl;
        ctx.beginPath();ctx.arc(x,y-ch*0.4,cw*2.4,0,7);ctx.fill();
      }
    } else {
      ctx.fillStyle=t2.color;
      roundRect(x-cw*0.35,y-ch*1.5,cw*0.7,ch*0.72,s*0.16);ctx.fill();
      ctx.fillStyle='rgba(20,26,36,0.75)';
      roundRect(x-cw*0.30,y-ch*1.42,cw*0.6,ch*0.5,s*0.12);ctx.fill();
      ctx.fillStyle='rgba(140,190,225,0.20)';
      roundRect(x-cw*0.26,y-ch*1.38,cw*0.5,ch*0.22,s*0.1);ctx.fill();
      ctx.fillStyle=t2.color;
      roundRect(x-cw/2,y-ch,cw,ch,s*0.24);ctx.fill();
      ctx.fillStyle='rgba(255,255,255,0.13)';
      roundRect(x-cw*0.42,y-ch*0.94,cw*0.84,ch*0.2,s*0.1);ctx.fill();
      var blinkOn=(t2.blink%2)>1.6?1:0.55;
      ctx.fillStyle='rgba(255,60,55,'+(0.78*blinkOn)+')';
      ctx.fillRect(x-cw*0.46,y-ch*0.62,cw*0.18,ch*0.26);
      ctx.fillRect(x+cw*0.28,y-ch*0.62,cw*0.18,ch*0.26);
    }
    ctx.globalAlpha=1;
  }
}

function drawSigns(sky){
  if(!G.signs) return;
  for(var i=0;i<G.signs.length;i++){
    var sg=G.signs[i];
    var rz=sg.z-G.camZ;
    if(rz<4||rz>320) continue;
    var s=FOCAL/rz;
    var x=W/2+(roadOffset(rz)+sg.lat-G.camLat)*s;
    var y=HORIZON_Y+CAM_H*s;
    ctx.globalAlpha=clamp((rz-4)/12,0,1)*clamp((320-rz)/50,0,1);
    var postH=5.5*s,postW=0.32*s;
    ctx.fillStyle='#6a6a6a';
    ctx.fillRect(x-postW/2,y-postH,postW,postH);
    var sw=10.5*s,sh=5.4*s;
    var sx=x-sw/2,sy=y-postH-sh;
    if(sw>4.5){
      ctx.fillStyle='#0d5c34';
      roundRect(sx,sy,sw,sh,s*0.35);ctx.fill();
      ctx.strokeStyle='rgba(255,255,255,0.85)';
      ctx.lineWidth=Math.max(0.8,s*0.14);
      roundRect(sx+s*0.3,sy+s*0.3,sw-s*0.6,sh-s*0.6,s*0.22);ctx.stroke();
      if(s>1.6){
        ctx.textAlign='center';ctx.textBaseline='middle';
        ctx.fillStyle='#ffffff';
        ctx.font='bold '+Math.max(5,s*1.2)+'px system-ui,sans-serif';
        ctx.fillText(sg.city.name,x,sy+sh*0.32);
        ctx.font='bold '+Math.max(4,s*0.9)+'px system-ui,sans-serif';
        ctx.fillStyle='rgba(255,255,255,0.88)';
        ctx.fillText(sg.distMi+' 英里',x,sy+sh*0.70);
      }
    }
    ctx.globalAlpha=1;
  }
}

function drawHoodOrCockpit(){
  var view=VIEW_MODES[G.viewIdx];
  var hoodTop=H*view.hoodH;

  if(view.id==='cockpit'){
    var grad=ctx.createLinearGradient(0,hoodTop-20,0,H);
    grad.addColorStop(0,'rgba(12,14,18,0)');
    grad.addColorStop(0.35,'rgba(12,14,18,0.92)');
    grad.addColorStop(1,'rgba(6,8,11,1)');
    ctx.fillStyle=grad;
    ctx.fillRect(0,hoodTop-20,W,H-hoodTop+20);

    var cx=W/2,cy=hoodTop+H*0.15,r=90;
    ctx.strokeStyle='rgba(30,32,38,0.95)';
    ctx.lineWidth=12;
    ctx.beginPath();ctx.arc(cx,cy,r,0,Math.PI*2);ctx.stroke();
    ctx.lineWidth=8;
    ctx.beginPath();ctx.moveTo(cx-r+15,cy);ctx.lineTo(cx+r-15,cy);ctx.stroke();
    ctx.beginPath();ctx.moveTo(cx,cy);ctx.lineTo(cx,cy+r-15);ctx.stroke();
    ctx.fillStyle='rgba(40,42,48,0.95)';
    ctx.beginPath();ctx.arc(cx,cy,22,0,7);ctx.fill();

    var gaugeY=hoodTop+H*0.10;
    for(var g=0;g<2;g++){
      var gx=W/2+(g===0?-150:150),gy=gaugeY;
      ctx.beginPath();
      ctx.arc(gx,gy,52,Math.PI*0.7,Math.PI*2.3);
      ctx.strokeStyle='rgba(60,64,74,0.7)';ctx.lineWidth=6;ctx.stroke();
      var speedRatio=g===0?clamp(G.speed/SPEED_MAX,0,1):G.fuel/100;
      var ang=Math.PI*0.7+Math.PI*1.6*speedRatio;
      ctx.strokeStyle=g===0?'#6ec6ff':'#4ade80';
      ctx.lineWidth=3;
      ctx.beginPath();
      ctx.moveTo(gx,gy);
      ctx.lineTo(gx+Math.cos(ang)*44,gy+Math.sin(ang)*44);
      ctx.stroke();
    }
  } else if(view.id==='chase'){
    // 追尾视角不画引擎盖
  } else {
    var grad2=ctx.createLinearGradient(0,hoodTop-30,0,H);
    grad2.addColorStop(0,'rgba(15,18,24,0)');
    grad2.addColorStop(0.4,'rgba(15,18,24,0.75)');
    grad2.addColorStop(0.8,'rgba(10,12,16,0.96)');
    grad2.addColorStop(1,'rgba(6,8,11,1)');
    ctx.fillStyle=grad2;
    ctx.fillRect(0,hoodTop-30,W,H-hoodTop+30);

    ctx.fillStyle='rgba(18,20,26,0.88)';
    ctx.beginPath();ctx.moveTo(0,hoodTop-40);ctx.lineTo(W*0.07,hoodTop+8);ctx.lineTo(0,hoodTop+60);ctx.closePath();ctx.fill();
    ctx.beginPath();ctx.moveTo(W,hoodTop-40);ctx.lineTo(W*0.93,hoodTop+8);ctx.lineTo(W,hoodTop+60);ctx.closePath();ctx.fill();

    var hoodGrad=ctx.createLinearGradient(0,hoodTop-6,0,hoodTop+70);
    hoodGrad.addColorStop(0,'rgba(58,62,70,0.92)');
    hoodGrad.addColorStop(1,'rgba(32,35,42,0.96)');
    ctx.fillStyle=hoodGrad;
    ctx.beginPath();
    ctx.moveTo(-10,hoodTop+8);
    ctx.quadraticCurveTo(W/2,hoodTop-14,W+10,hoodTop+8);
    ctx.lineTo(W+10,H+10);ctx.lineTo(-10,H+10);
    ctx.closePath();ctx.fill();

    ctx.strokeStyle='rgba(90,105,125,0.28)';
    ctx.lineWidth=1.5;
    ctx.beginPath();
    ctx.moveTo(-10,hoodTop+8);
    ctx.quadraticCurveTo(W/2,hoodTop-14,W+10,hoodTop+8);
    ctx.stroke();

    ctx.strokeStyle='rgba(35,38,45,0.95)';ctx.lineWidth=3;ctx.lineCap='round';
    ctx.beginPath();ctx.moveTo(W*0.22,hoodTop+18);ctx.lineTo(W*0.42,hoodTop-4);ctx.stroke();
    ctx.beginPath();ctx.moveTo(W*0.62,hoodTop+18);ctx.lineTo(W*0.52,hoodTop-4);ctx.stroke();
    ctx.lineCap='butt';
  }

  if(G.blinkers>0&&G.blinkSide!==0){
    var blinkOn=(Math.sin(G.time*8)>0);
    if(blinkOn){
      ctx.fillStyle='rgba(255,180,60,0.9)';
      var indY=hoodTop-14;
      if(G.blinkSide===1){
        ctx.beginPath();
        ctx.moveTo(W*0.86,indY);ctx.lineTo(W*0.90,indY+6);ctx.lineTo(W*0.86,indY+12);
        ctx.closePath();ctx.fill();
      } else {
        ctx.beginPath();
        ctx.moveTo(W*0.14,indY);ctx.lineTo(W*0.10,indY+6);ctx.lineTo(W*0.14,indY+12);
        ctx.closePath();ctx.fill();
      }
    }
  }
}

