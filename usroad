  roundRect(MAP_X-12,MAP_Y-12,MAP_W+24,MAP_H+24,16);ctx.stroke();

  ctx.beginPath();
  for(var i=0;i<US_OUTLINE.length;i++){
    var p=US_OUTLINE[i];
    var x=toMapX(p[0]),y=toMapY(p[1]);
    if(i===0) ctx.moveTo(x,y); else ctx.lineTo(x,y);
  }
  ctx.closePath();
  ctx.fillStyle='rgba(90,140,220,0.065)';ctx.fill();
  ctx.strokeStyle='rgba(120,170,255,0.24)';ctx.lineWidth=1.3;ctx.stroke();

  ctx.strokeStyle='rgba(120,170,255,0.10)';ctx.lineWidth=1;
  for(var hi=0;hi<HIGHWAYS.length;hi++){
    var hw=HIGHWAYS[hi];
    var a=CITY_MAP[hw[0]],bb=CITY_MAP[hw[1]];
    if(!a||!bb) continue;
    ctx.beginPath();
    ctx.moveTo(toMapX(a.lng),toMapY(a.lat));
    ctx.lineTo(toMapX(bb.lng),toMapY(bb.lat));
    ctx.stroke();
  }

  var st=menuStage();
  if(G.menuFrom&&G.menuTo&&st==='ready'&&G.driveMode!=='free'){
    var path=shortestPath(G.menuFrom.id,G.menuTo.id);
    if(path){
      ctx.strokeStyle='rgba(255,209,102,0.9)';ctx.lineWidth=2.4;
      ctx.setLineDash([7,6]);ctx.lineDashOffset=-G.time*28;
      ctx.beginPath();
      var cur=CITY_MAP[path[0].from];
      ctx.moveTo(toMapX(cur.lng),toMapY(cur.lat));
      for(var pi=0;pi<path.length;pi++){
        var nxt=CITY_MAP[path[pi].to];
        ctx.lineTo(toMapX(nxt.lng),toMapY(nxt.lat));
      }
      ctx.stroke();ctx.setLineDash([]);
    }
  }

  for(var ci2=0;ci2<CITIES.length;ci2++){
    var c2=CITIES[ci2];
