    var a=CITY_MAP[hw[0]],b=CITY_MAP[hw[1]];
    if(!a||!b) continue;
    var d=Math.round(haversine(a,b)*1.16/5)*5;
    GRAPH[a.id].push({to:b.id,name:hw[2],miles:d});
    GRAPH[b.id].push({to:a.id,name:hw[2],miles:d});
  }
})();

function shortestPath(fromId,toId){
  var dist={},prev={},visited={};
  for(var id in GRAPH) dist[id]=Infinity;
  dist[fromId]=0;
  for(;;){
    var u=null,best=Infinity;
    for(var k in dist){if(!visited[k]&&dist[k]<best){best=dist[k];u=k;}}
    if(u===null||u===toId) break;
    visited[u]=true;
    var nbrs=GRAPH[u];
    for(var i=0;i<nbrs.length;i++){
      var e=nbrs[i],nd=dist[u]+e.miles;
      if(nd<dist[e.to]){dist[e.to]=nd;prev[e.to]={from:u,edge:e};}
    }
  }
  if(dist[toId]===Infinity) return null;
  var path=[],cur=toId;
  while(cur!==fromId){
    var p=prev[cur];
    if(!p) return null;
    path.unshift({from:p.from,to:cur,name:p.edge.name,miles:p.edge.miles});
    cur=p.from;
  }
  return path;
}

