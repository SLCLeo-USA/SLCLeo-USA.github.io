        for(var si=0;si<route.segments.length-1;si++) midNames.push(CITY_MAP[route.segments[si].to].name);
        ctx.fillText(midNames.slice(0,5).join(' · ')+(midNames.length>5?' …':''),IX+140,IY+112);
      }
    }
    var pulse=0.5+Math.sin(G.time*3)*0.5;
    var bw=150,bh=52;
    var bx=IX+IW-bw-20,by=IY+IH-bh-16;
