var WORLD_PER_MILE={casual:5.5,real:22.0,free:6.5};

function buildRouteFromPath(path,fromCity,toCity){
  if(!path||!path.length) return null;
  var wpm=WORLD_PER_MILE[G.driveMode]||5.5;
  var segs=[],wz=0,totalMiles=0;
  for(var i=0;i<path.length;i++){
    var p=path[i];
    var len=Math.max(600,p.miles*wpm);
    segs.push({from:p.from,to:p.to,name:p.name,miles:p.miles,worldStart:wz,worldEnd:wz+len,worldLen:len});
    wz+=len;totalMiles+=p.miles;
  }
  return {segments:segs,totalMiles:totalMiles,totalWorld:wz,fromCity:fromCity,toCity:toCity};
}
function buildFreeRoute(fromCity,edge,toCity){
  var wpm=WORLD_PER_MILE[G.driveMode]||5.5;
  var len=Math.max(600,edge.miles*wpm);
  var seg={from:fromCity.id,to:toCity.id,name:edge.name,miles:edge.miles,worldStart:0,worldEnd:len,worldLen:len};
  return {segments:[seg],totalMiles:edge.miles,totalWorld:len,fromCity:fromCity,toCity:toCity};
}
function segAtWorld(route,wz){
  if(!route||!route.segments) return null;
  var segs=route.segments;
  for(var i=0;i<segs.length;i++){if(wz<=segs[i].worldEnd) return segs[i];}
  return segs[segs.length-1];
}

function generateExitZones(){
  if(!G.route) return [];
  var zones=[];
  var segs=G.route.segments;
  // 城市匝道
  for(var i=0;i<segs.length;i++){
    var seg=segs[i];
    var cityId=seg.to;
    var nbrs=GRAPH[cityId]||[];
    var opts=[];
    for(var j=0;j<nbrs.length;j++){
      if(nbrs[j].to!==seg.from) opts.push(nbrs[j]);
    }
    zones.push({
      type:'city',zStart:seg.worldEnd-280,zEnd:seg.worldEnd,
      city:CITY_MAP[cityId],from:seg.from,to:seg.to,name:seg.name,
      opts:opts,exited:false
    });
  }
  // 服务区
  for(var k=0;k<segs.length;k++){
    var s2=segs[k];
    var numSv=Math.max(1,Math.floor(s2.worldLen/2400));
    for(var m=0;m<numSv;m++){
      var zPos=s2.worldStart+s2.worldLen*(0.28+m*0.42/numSv);
      var kind=Math.random()<0.62?'gas':'rest';
      zones.push({
        type:'service',zStart:zPos,zEnd:zPos+100,
        lat:ROAD_HW+SHOULDER+5,kind:kind,
        name:['Shell','Chevron','BP','Exxon','Texaco','76','Mobil','Sunoco'][randi(8)]
      });
    }
  }
  zones.sort(function(a,b){return a.zStart-b.zStart;});
  return zones;
}

